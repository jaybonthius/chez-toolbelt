(import (chezscheme) (ghostty) (check))

(define (bytes s) (string->utf8 s))

(define-syntax with-terminal
  (syntax-rules ()
    [(_ (t columns rows) body ...)
     (let ([t (make-terminal columns rows)])
       (dynamic-wind void (lambda () body ...) (lambda () (terminal-close! t))))]))

(define (runs-of row) (vector->list (render-row-runs row)))
(define (row-text row) (apply string-append (map render-run-text (runs-of row))))
(define (texts rs) (map row-text (render-state-rows rs)))

(test "dirty state, dimensions and clean frames"
  (with-terminal (t 8 3)
    (let ([rs (make-render-state)])
      (check-equal? 'full (render-state-update! rs t))
      (check-equal? 8 (render-state-columns rs))
      (check-equal? 3 (render-state-row-count rs))
      (check-equal? 3 (length (render-state-dirty-rows rs)))
      (render-state-clean! rs)
      (check-equal? 'clean (render-state-dirty rs))
      (check-equal? '() (render-state-dirty-rows rs))
      (check-equal? 'clean (render-state-update! rs t))
      (check-equal? '(#f #f #f) (map render-row-dirty? (render-state-rows rs)))
      (terminal-write! t (bytes "changed"))
      (check-equal? 'partial (render-state-update! rs t))
      (check-equal? '(#t #f #f) (map render-row-dirty? (render-state-rows rs)))
      (check-equal? '("changed") (map row-text (render-state-dirty-rows rs)))
      (render-state-clean! rs)
      (terminal-resize! t 10 4)
      (check-equal? 'full (render-state-update! rs t))
      (check-equal? 10 (render-state-columns rs))
      (check-equal? 4 (render-state-row-count rs))
      (let ([rows (render-state-rows rs)])
        (terminal-close! t)
        (check-equal? "changed" (row-text (car rows)))
        (check-equal? "changed" (row-text (car (render-state-rows rs))))
        (check-raises assertion-violation? (render-state-update! rs t)))
      (render-state-close! rs)
      (render-state-close! rs)
      (check (render-state-closed? rs))
      (check-raises assertion-violation? (render-state-rows rs)))))

(test "rows merge cells into runs with shared styles, links and wide text"
  (with-terminal (t 20 3)
    (terminal-write! t (bytes "ab\x1b;[1;31mcd\x1b;[0m\x1b;]8;;https://x\x7;e\x1b;]8;;\x7;界z\r\n\x1b;[44m  \x1b;[0m"))
    (let ([rs (make-render-state)])
      (render-state-update! rs t)
      (let* ([rows (render-state-rows rs)] [runs (runs-of (car rows))])
        (check-equal? 3 (length rows))
        (check-equal? '(0 1 2) (map render-row-y rows))
        (check-equal? '("ab" "cd" "e" "界z") (map render-run-text runs))
        (check-equal? '(0 2 4 5) (map render-run-column runs))
        (check-equal? '(2 2 1 3) (map render-run-width runs))
        (check (style-bold? (render-run-style (cadr runs))))
        (check-equal? 1 (style-foreground (render-run-style (cadr runs))))
        (check (eq? (render-run-style (car runs)) (render-run-style (cadddr runs))))
        (check-equal? '(#f #f "https://x" #f) (map render-run-hyperlink runs))
        (check-equal? '(output output output output) (map render-run-semantic-content runs))
        (let ([blue (car (runs-of (cadr rows)))])
          (check-equal? "  " (render-run-text blue))
          (check-equal? 4 (style-background (render-run-style blue))))
        (check-equal? '() (runs-of (caddr rows))))
      (terminal-select! t (make-grid-point 'active 1 0) (make-grid-point 'active 2 0))
      (render-state-update! rs t)
      (let* ([row (car (render-state-rows rs))] [runs (runs-of row)])
        (check-equal? 1 (render-row-selection-start row))
        (check-equal? 2 (render-row-selection-end row))
        (check-equal? '("a" "b" "c" "d" "e" "界z") (map render-run-text runs))
        (check-equal? '(#f #t #t #f #f #f) (map render-run-selected? runs)))
      (render-state-close! rs))))

(test "styles: colors, flags and underline variants"
  (with-terminal (t 40 4)
    (terminal-write! t (bytes "\x1b;]133;A\x7;\x1b;[1;2;3;5;7;8;9;53;31;48;2;1;2;3;58;5;4;4:3mX\x1b;[0m"))
    (do ([v 1 (+ v 1)]) ((= v 6))
      (terminal-write! t (bytes (format "\x1b;[4:~amU\x1b;[0m" v))))
    (let ([rs (make-render-state)])
      (render-state-update! rs t)
      (let* ([row (car (render-state-rows rs))] [runs (runs-of row)] [style (render-run-style (car runs))])
        (check-equal? 'prompt (render-row-semantic-prompt row))
        (check-equal? 'prompt (render-run-semantic-content (car runs)))
        (check-equal? 1 (style-foreground style))
        (check-equal? (make-rgb 1 2 3) (style-background style))
        (check-equal? 4 (style-underline-color style))
        (check (for-all (lambda (flag) (flag style))
                 (list style-bold? style-italic? style-faint? style-blink? style-inverse?
                       style-invisible? style-strikethrough? style-overline?)))
        (check-equal? 'curly (style-underline style))
        (check-equal? '(single double curly dotted dashed)
          (map (lambda (run) (style-underline (render-run-style run))) (cdr runs))))
      (render-state-close! rs))))

(test "graphemes, wide characters, soft wraps and spacer heads"
  (with-terminal (t 6 4)
    (terminal-resize! t 10 4)
    (terminal-write! t (bytes "界e\x301;👩\x200d;💻"))
    (let ([rs (make-render-state)])
      (render-state-update! rs t)
      (check-equal? "界e\x301;👩\x200d;💻" (row-text (car (render-state-rows rs))))
      (check-equal? 7 (render-run-width (car (runs-of (car (render-state-rows rs))))))
      (terminal-resize! t 6 4)
      (terminal-reset! t)
      (terminal-write! t (bytes "abcde界x"))
      (render-state-update! rs t)
      (let ([rows (render-state-rows rs)])
        (check (render-row-wrap? (car rows)))
        (check (render-row-wrap-continuation? (cadr rows)))
        (check-equal? "abcde" (row-text (car rows)))
        (check-equal? "界x" (row-text (cadr rows))))
      (render-state-close! rs))))

(test "color-only cells become runs with that background"
  (with-terminal (t 3 2)
    (terminal-write! t (bytes "\x1b;[41m\x1b;[2K\x1b;[0m\r\n\x1b;[48;2;1;2;3m\x1b;[2K"))
    (let ([rs (make-render-state)])
      (render-state-update! rs t)
      (let ([rows (render-state-rows rs)])
        (check-equal? "   " (row-text (car rows)))
        (check-equal? 1 (style-background (render-run-style (car (runs-of (car rows))))))
        (check-equal? (make-rgb 1 2 3) (style-background (render-run-style (car (runs-of (cadr rows)))))))
      (render-state-close! rs))))

(test "colors and the cursor"
  (with-terminal (t 8 2)
    (terminal-write! t (bytes "\x1b;]10;#112233\x7;\x1b;]11;#223344\x7;\x1b;]12;#334455\x7;\x1b;]4;5;#445566\x7;"))
    (terminal-write! t (bytes "界\x1b;[1;2H\x1b;[5 q"))
    (let ([rs (make-render-state)])
      (render-state-update! rs t)
      (let ([colors (render-state-colors rs)] [cursor (render-state-cursor rs)])
        (check-equal? (make-rgb 17 34 51) (render-colors-foreground colors))
        (check-equal? (make-rgb 34 51 68) (render-colors-background colors))
        (check-equal? (make-rgb 51 68 85) (render-colors-cursor colors))
        (check-equal? (make-rgb 68 85 102) (vector-ref (render-colors-palette colors) 5))
        (check-equal? 'bar (render-cursor-style cursor))
        (check (render-cursor-visible? cursor))
        (check (render-cursor-blinking? cursor))
        (check (not (render-cursor-password-input? cursor)))
        (check-equal? '(1 0 #t) (list (render-cursor-column cursor) (render-cursor-row cursor)
                                      (render-cursor-wide-tail? cursor))))
      (terminal-write! t (bytes "\x1b;[?25l"))
      (render-state-update! rs t)
      (check (not (render-cursor-visible? (render-state-cursor rs))))
      (terminal-write! t (bytes "\r\n\r\n\r\n"))
      (terminal-scroll-to-top! t)
      (render-state-update! rs t)
      (check-equal? #f (render-cursor-row (render-state-cursor rs)))
      (render-state-close! rs))))

(test "row ids follow rows as they scroll"
  (with-terminal (t 5 3)
    (terminal-write! t (bytes "a\r\nb\r\nc"))
    (let ([rs (make-render-state)])
      (render-state-update! rs t)
      (let ([before (map render-row-id (render-state-rows rs))])
        (check (for-all integer? before))
        (terminal-write! t (bytes "\r\nd"))
        (render-state-update! rs t)
        (let ([after (map render-row-id (render-state-rows rs))])
          (check-equal? (cdr before) (list (car after) (cadr after)))
          (check (not (memv (caddr after) before)))))
      (render-state-close! rs))))

(test "overscan captures rows beyond the viewport"
  (with-terminal (t 5 2)
    (terminal-write! t (bytes "1\r\n2\r\n3\r\n4\r\n5\r\n6"))
    (terminal-scroll-to-row! t 2)
    (let ([rs (make-render-state)])
      (render-state-set-overscan! rs 1 1)
      (render-state-update! rs t)
      (let-values ([(above below) (render-state-overscan rs)])
        (check-equal? 1 above)
        (check-equal? 1 below))
      (check-equal? '(-1 0 1 2) (map render-row-y (render-state-rows rs)))
      (check-equal? '("2" "3" "4" "5") (texts rs))
      (render-state-close! rs))))

(test "overscan rows keep their hyperlinks"
  (with-terminal (t 20 3)
    (let ([link (lambda (n) (format "\x1b;]8;;https://~a.test\x1b;\\link~a\x1b;]8;;\x1b;\\\r\n" n n))]
          [rs (make-render-state)]
          [links (lambda (rs)
                   (map (lambda (row)
                          (cons (render-row-y row)
                            (map render-run-hyperlink (runs-of row))))
                        (render-state-rows rs)))])
      (terminal-write! t (bytes (link 0)))
      (do ([i 1 (+ i 1)]) ((= i 6)) (terminal-write! t (bytes (format "row ~a\r\n" i))))
      (terminal-write! t (bytes (link 6)))
      (render-state-set-overscan! rs 10 10)
      (render-state-update! rs t)
      (check-equal? '((-5 "https://0.test") (-4 #f) (-3 #f) (-2 #f) (-1 #f) (0 #f)
                      (1 "https://6.test") (2))
        (links rs))
      (terminal-scroll-to-top! t)
      (render-state-update! rs t)
      (check-equal? '((0 "https://0.test") (1 #f) (2 #f) (3 #f) (4 #f) (5 #f)
                      (6 "https://6.test") (7))
        (links rs))
      (render-state-close! rs))))

(test "a render-hold handler captures the frame the program wants shown"
  (with-terminal (t 10 2)
    (let ([rs (make-render-state)] [held #f])
      (terminal-set-render-hold-handler! t
        (lambda (hold?)
          (set! held hold?)
          (when hold? (render-state-update! rs t))))
      (terminal-write! t (bytes "old"))
      (render-state-update! rs t)
      (terminal-write! t (bytes "\x1b;[?2026h\x1b;[H\x1b;[2Jnew"))
      (check held)
      (check-equal? '("old" "") (texts rs))
      (terminal-write! t (bytes "\x1b;[?2026l"))
      (check (not held))
      (render-state-update! rs t)
      (check-equal? '("new" "") (texts rs))
      (render-state-close! rs))))

(test "Kitty images and placements"
  (with-terminal (t 10 5)
    (terminal-resize! t 10 5 8 16)
    (check-equal? 0 (terminal-kitty-generation t))
    (check-equal? '() (terminal-kitty-placements t))
    (terminal-write! t (bytes "\x1b;_Ga=T,t=d,f=24,i=1,p=1,s=1,v=2;////////\x1b;\\"))
    (let ([placement (car (terminal-kitty-placements t))] [image (terminal-kitty-image t 1)])
      (check-equal? 1 (kitty-placement-image-id placement))
      (check-equal? 1 (kitty-placement-placement-id placement))
      (check-equal? 'above-text (kitty-placement-layer placement))
      (check-equal? '(1 2 1 1)
        (list (kitty-placement-pixel-width placement) (kitty-placement-pixel-height placement)
              (kitty-placement-columns placement) (kitty-placement-rows placement)))
      (check-equal? '(0 0) (list (kitty-placement-viewport-column placement)
                                 (kitty-placement-viewport-row placement)))
      (check-equal? '(0 0 1 2) (list (kitty-placement-source-x placement)
                                     (kitty-placement-source-y placement)
                                     (kitty-placement-source-width placement)
                                     (kitty-placement-source-height placement)))
      (check-equal? 'rgb (kitty-image-format image))
      (check-equal? '(1 2) (list (kitty-image-width image) (kitty-image-height image)))
      (check-equal? (make-bytevector 6 255) (kitty-image-data image)))
    (check (> (terminal-kitty-generation t) 0))
    (terminal-write! t (bytes "\x1b;_Ga=T,t=d,f=32,i=2,p=1,s=1,v=1,z=-5;AQIDBA==\x1b;\\"))
    (check-equal? (bytevector 1 2 3 4) (kitty-image-data (terminal-kitty-image t 2)))
    (check (memq 'below-text (map kitty-placement-layer (terminal-kitty-placements t))))
    (terminal-write! t (bytes "\x1b;_Ga=T,t=d,f=24,o=z,i=3,p=1,s=1,v=1;eAEBAwD8//8AAAMAAQA=\x1b;\\"))
    (check-equal? (bytevector 255 0 0) (kitty-image-data (terminal-kitty-image t 3)))
    (check-equal? #f (terminal-kitty-image t 99))))

(test-exit)
