(import (chezscheme) (ghostty) (check))

(define (bytes s) (string->utf8 s))

(define-syntax with-terminal
  (syntax-rules ()
    [(_ (t columns rows) body ...)
     (let ([t (make-terminal columns rows)])
       (dynamic-wind void (lambda () body ...) (lambda () (terminal-close! t))))]))

(define (key e . args) (utf8->string (key-encoder-encode e (apply make-key-event args))))
(define (mouse e . args) (utf8->string (mouse-encoder-encode e (apply make-mouse-event args))))

(define geometry (make-mouse-geometry 100 80 10 20 5 5 5 5))

(define (make-mouse)
  (let ([e (make-mouse-encoder)]) (mouse-encoder-set-geometry! e geometry) e))

(test "legacy keys and cursor-key mode from the terminal"
  (let ([e (make-key-encoder)])
    (check-equal? "a" (key e 'press 'a (key-modifiers) "a"))
    (check-equal? "" (key e 'release 'a (key-modifiers) "a"))
    (check-equal? "\x1b;[A" (key e 'press 'arrow-up))
    (check-equal? "\x1;" (key e 'press 'a (key-modifiers ctrl) "a"))
    (with-terminal (t 80 24)
      (terminal-write! t (bytes "\x1b;[?1h"))
      (key-encoder-sync! e t)
      (check-equal? "\x1b;OA" (key e 'press 'arrow-up))
      (terminal-write! t (bytes "\x1b;[?1l"))
      (key-encoder-sync! e t)
      (check-equal? "\x1b;[A" (key e 'press 'arrow-up)))
    (key-encoder-close! e)))

(test "backarrow, modifyOtherKeys, keypad and option settings"
  (let ([e (make-key-encoder)])
    (check-equal? "\x7f;" (key e 'press 'backspace))
    (key-encoder-set-backarrow-key-mode! e #t)
    (check-equal? "\b" (key e 'press 'backspace))
    (key-encoder-set-modify-other-keys! e #t)
    (check-equal? "\x1b;[27;2;65~" (key e 'press 'a (key-modifiers shift) "A"))
    (key-encoder-set-modify-other-keys! e #f)
    (key-encoder-set-keypad-key-application! e #t)
    (key-encoder-set-ignore-keypad-with-numlock! e #f)
    (check-equal? "\x1b;Oq" (key e 'press 'numpad-1))
    (key-encoder-set-ignore-keypad-with-numlock! e #t)
    (check-equal? "1" (key e 'press 'numpad-1 (key-modifiers num-lock)))
    (key-encoder-set-alt-esc-prefix! e #f)
    (key-encoder-set-keypad-key-application! e #f)
    (check-equal? "x" (key e 'press 'x (key-modifiers alt right-alt) "x"))
    (key-encoder-set-alt-esc-prefix! e #t)
    (for-each
      (lambda (option)
        (key-encoder-set-option-as-alt! e option)
        (check-equal? "\x1b;x" (key e 'press 'x (key-modifiers alt right-alt) "x"))
        (check-equal? "\x1b;界" (key e 'press 'a (key-modifiers alt) "界")))
      '(#f #t left right))
    (check-raises assertion-violation? (key-encoder-set-option-as-alt! e 'both))
    (check-raises assertion-violation? (key-encoder-set-alt-esc-prefix! e 1))
    (key-encoder-close! e)))

(test "Kitty keyboard: events, alternates, consumed modifiers, composition"
  (let ([e (make-key-encoder)])
    (key-encoder-set-kitty-flags! e
      (kitty-key-flags disambiguate report-events report-alternates report-all report-associated))
    (check-equal? "\x1b;[57442;5:3u" (key e 'release 'control-left (key-modifiers ctrl)))
    (check-equal? "\x1b;[57441;1:3u" (key e 'release 'shift-left))
    (check-equal? "a" (key e 'repeat 'a (key-modifiers shift) "a" #f #f (key-modifiers shift)))
    (check-equal? "\x1b;[97;2:2;97u"
      (key e 'repeat 'a (key-modifiers shift) "a" #\a #f (key-modifiers shift)))
    (check-equal? "" (key e 'press 'a (key-modifiers) "a" #f #t))
    (let ([out (key e 'press 'a (key-modifiers) (string-append (make-string 200 #\a) "界") #\a)])
      (check (> (string-length out) 128))
      (check-equal? "\x1b;[97;;97:97:97:" (substring out 0 15))
      (check-equal? ":30028u" (substring out (- (string-length out) 7) (string-length out))))
    (with-terminal (t 10 2)
      (terminal-write! t (bytes "\x1b;[>1u"))
      (check (enum-set=? (kitty-key-flags disambiguate) (terminal-kitty-keyboard-flags t)))
      (key-encoder-sync! e t)
      (check-equal? "\x1b;[27u" (key e 'press 'escape)))
    (check-raises assertion-violation? (key-encoder-set-kitty-flags! e (key-modifiers shift)))
    (key-encoder-close! e)))

(test "key events check their fields"
  (for-each
    (lambda (text) (check-raises assertion-violation? (make-key-event 'press 'a (key-modifiers) text)))
    (list "x\x0;y" "\x1f;" "\x7f;" "\xf700;" "\xf8ff;"))
  (check-raises assertion-violation? (make-key-event 'press 'not-a-key))
  (check-raises assertion-violation? (make-key-event 'held 'a))
  (check-raises assertion-violation? (make-key-event 'press 'a '(ctrl)))
  (check-raises assertion-violation? (make-key-event 'press 'a (key-modifiers) "a" 97))
  (check (key-event? (make-key-event 'press 'f25)))
  (check (key-event? (make-key-event 'press 'audio-volume-up)))
  (check-equal? (make-key-event 'press 'a (key-modifiers ctrl))
    (make-key-event 'press 'a (key-modifiers ctrl) #f #f #f (key-modifiers))))

(test "mouse tracking modes, buttons, modifiers and every format"
  (let ([e (make-mouse)])
    (check-equal? "" (mouse e 'press 'left 0 0))
    (mouse-encoder-set-tracking! e 'x10)
    (mouse-encoder-set-format! e 'x10)
    (check-equal? "\x1b;[M !!" (mouse e 'press 'left 0 0))
    (check-equal? "" (mouse e 'release 'left 0 0))
    (mouse-encoder-set-tracking! e 'normal)
    (mouse-encoder-set-format! e 'sgr)
    (check-equal? "\x1b;[<0;1;1M" (mouse e 'press 'left 0 0))
    (check-equal? "\x1b;[<0;1;1m" (mouse e 'release 'left 0 0))
    (check-equal? "" (mouse e 'motion #f 10 20))
    (mouse-encoder-set-tracking! e 'button)
    (mouse-encoder-set-any-button-pressed! e #t)
    (check-equal? "\x1b;[<32;1;1M" (mouse e 'motion 'left 10 20))
    (mouse-encoder-set-tracking! e 'any)
    (mouse-encoder-set-any-button-pressed! e #f)
    (check-equal? "\x1b;[<55;2;2M" (mouse e 'motion #f 15 25 (key-modifiers shift ctrl)))
    (for-each
      (lambda (entry)
        (mouse-encoder-set-format! e (car entry))
        (check-equal? (cdr entry) (mouse e 'press 'left 20 40)))
      '((x10 . "\x1b;[M \x22;\x22;") (utf8 . "\x1b;[M \x22;\x22;") (sgr . "\x1b;[<0;2;2M")
        (urxvt . "\x1b;[32;2;2M") (sgr-pixels . "\x1b;[<0;15;35M")))
    (mouse-encoder-set-format! e 'sgr)
    (check-equal? "\x1b;[<64;1;1M" (mouse e 'press 'four 5 5))
    (check-equal? "\x1b;[<2;1;1M" (mouse e 'press 'right 5 5))
    (check-raises assertion-violation? (mouse-encoder-set-format! e 'json))
    (check-raises assertion-violation? (mouse-encoder-set-tracking! e 'all))
    (mouse-encoder-close! e)))

(test "mouse positions outside the surface follow native policy"
  (let ([e (make-mouse)])
    (mouse-encoder-set-tracking! e 'any)
    (mouse-encoder-set-format! e 'sgr-pixels)
    (mouse-encoder-set-any-button-pressed! e #t)
    (mouse-encoder-set-track-last-cell! e #f)
    (for-each
      (lambda (entry)
        (check-equal? (caddr entry)
          (mouse e 'motion #f (car entry) (cadr entry) (key-modifiers shift ctrl))))
      '((-1 -1 "\x1b;[<55;-6;-6M") (0 0 "\x1b;[<55;-5;-5M") (4 4 "\x1b;[<55;-1;-1M")
        (5 5 "\x1b;[<55;0;0M") (94 74 "\x1b;[<55;89;69M") (95 75 "\x1b;[<55;90;70M")
        (100 80 "\x1b;[<55;95;75M") (150 100 "\x1b;[<55;145;95M")))
    (mouse-encoder-close! e)))

(test "positions the native encoder cannot represent are refused"
  (check-raises assertion-violation? (make-mouse-event 'motion #f +nan.0 0))
  (check-raises assertion-violation? (make-mouse-event 'motion #f +inf.0 0))
  (let ([e (make-mouse)])
    (mouse-encoder-set-tracking! e 'any)
    (mouse-encoder-set-format! e 'sgr-pixels)
    (mouse-encoder-set-track-last-cell! e #f)
    (mouse-encoder-set-any-button-pressed! e #t)
    (check-raises assertion-violation? (mouse e 'motion #f -2147483648 0))
    (check-raises assertion-violation? (mouse e 'motion #f 655365 0))
    (check-raises assertion-violation? (mouse e 'motion #f 1e39 0))
    (mouse-encoder-set-geometry! e (make-mouse-geometry 100 80 4294967295 4294967295 0 0 0 0))
    (check-equal? "\x1b;[<35;-2147483648;0M" (mouse e 'motion #f -2147483648 0))
    (check-equal? "\x1b;[<35;2147483520;0M" (mouse e 'motion #f 2147483520 0))
    (check-raises assertion-violation? (mouse e 'motion #f 2147483647 0))
    (mouse-encoder-set-geometry! e geometry)
    (check-equal? "\x1b;[<35;1;1M" (mouse e 'motion #f 5.5 5.5))
    (check-raises assertion-violation? (make-mouse-geometry 100 80 10 20 0 0 1 4294967295))
    (check-raises assertion-violation? (make-mouse-geometry 100 80 10 20 1 4294967295 0 0))
    (check-raises assertion-violation? (make-mouse-geometry 100 80 0 20 0 0 0 0))
    (mouse-encoder-close! e))
  (let ([e (make-mouse-encoder)])
    (check-raises assertion-violation? (mouse e 'press 'left 0 0))
    (mouse-encoder-close! e)))

(test "UTF-8 mouse coordinates stay scalars that fit"
  (let ([e (make-mouse-encoder)])
    (mouse-encoder-set-geometry! e (make-mouse-geometry 65535 65535 1 1 0 0 0 0))
    (mouse-encoder-set-tracking! e 'normal)
    (mouse-encoder-set-format! e 'utf8)
    (for-each
      (lambda (c)
        (check-raises assertion-violation? (mouse e 'release 'left c 0))
        (check-raises assertion-violation? (mouse e 'release 'left 0 c)))
      '(55263 57310))
    (for-each
      (lambda (c)
        (let ([scalar (string (integer->char (+ c 33)))])
          (check-equal? (string-append "\x1b;[M#" scalar "!") (mouse e 'release 'left c 0))
          (check-equal? (string-append "\x1b;[M#!" scalar) (mouse e 'release 'left 0 c))))
      '(55262 57311))
    (check-raises assertion-violation? (mouse e 'release 'left 0 65503))
    (check-equal? (string-append "\x1b;[M#" (string (integer->char 65567) (integer->char 65535)))
      (mouse e 'release 'left 65534 65502))
    (mouse-encoder-set-format! e 'sgr)
    (check-equal? "\x1b;[<0;55264;65504m" (mouse e 'release 'left 55263 65503))
    (with-terminal (t 8 2)
      (terminal-write! t (bytes "\x1b;[?1000h\x1b;[?1005h"))
      (mouse-encoder-sync! e t)
      (check-raises assertion-violation? (mouse e 'release 'left 55263 0))
      (terminal-write! t (bytes "\x1b;[?1005l\x1b;[?1006h"))
      (mouse-encoder-sync! e t)
      (check-equal? "\x1b;[<0;55264;1m" (mouse e 'release 'left 55263 0)))
    (mouse-encoder-close! e)))

(test "motion deduplication, geometry changes and reset"
  (let ([e (make-mouse)])
    (mouse-encoder-set-tracking! e 'any)
    (mouse-encoder-set-format! e 'sgr)
    (mouse-encoder-set-track-last-cell! e #t)
    (check-equal? "\x1b;[<35;2;2M" (mouse e 'motion #f 15 25))
    (check-equal? "" (mouse e 'motion #f 15 25))
    (mouse-encoder-reset! e)
    (check-equal? "\x1b;[<35;2;2M" (mouse e 'motion #f 15 25))
    (mouse-encoder-set-geometry! e (make-mouse-geometry 200 160 20 40 10 10 10 10))
    (check-equal? "\x1b;[<35;1;1M" (mouse e 'motion #f 15 25))
    (mouse-encoder-set-track-last-cell! e #f)
    (check-equal? "\x1b;[<35;1;1M" (mouse e 'motion #f 15 25))
    (mouse-encoder-close! e)))

(test "mouse modes from the terminal"
  (let ([e (make-mouse)])
    (with-terminal (t 80 24)
      (mouse-encoder-sync! e t)
      (check-equal? "" (mouse e 'press 'left 0 0))
      (terminal-write! t (bytes "\x1b;[?1000h\x1b;[?1006h"))
      (mouse-encoder-sync! e t)
      (check-equal? "\x1b;[<0;1;1M" (mouse e 'press 'left 0 0))
      (terminal-write! t (bytes "\x1b;[?1000l"))
      (mouse-encoder-sync! e t)
      (check-equal? "" (mouse e 'press 'left 0 0)))
    (mouse-encoder-close! e)))

(test "closed encoders and closed terminals"
  (let ([k (make-key-encoder)] [m (make-mouse-encoder)] [t (make-terminal 5 2)])
    (key-encoder-close! k)
    (key-encoder-close! k)
    (mouse-encoder-close! m)
    (check (key-encoder-closed? k))
    (check (mouse-encoder-closed? m))
    (check-raises assertion-violation? (key-encoder-encode k (make-key-event 'press 'a)))
    (check-raises assertion-violation? (mouse-encoder-reset! m))
    (terminal-close! t)
    (let ([k (make-key-encoder)])
      (check-raises assertion-violation? (key-encoder-sync! k t))
      (key-encoder-close! k))))

(test "encoders from several threads"
  (let ([e (make-key-encoder)] [results '()] [m (make-mutex)])
    (let ([threads
           (map (lambda (i)
                  (fork-thread
                    (lambda ()
                      (do ([n 0 (+ n 1)]) ((= n 500))
                        (let ([out (key e 'press 'a (key-modifiers) "a")])
                          (unless (equal? out "a")
                            (with-mutex m (set! results (cons out results)))))))))
                (iota 4))])
      (for-each thread-join threads)
      (check-equal? '() results))
    (key-encoder-close! e)))

(test-exit)
