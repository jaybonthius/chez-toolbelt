(import (chezscheme) (ghostty) (check))

(define (bytes s) (string->utf8 s))
(define (wire bv) (utf8->string bv))

(test "color syntaxes"
  (check-equal? (make-rgb #xaa #xbb #xcc) (color-parse "#abc"))
  (check-equal? (make-rgb #xaa #xbb #xcc) (color-parse "abc"))
  (check-equal? (make-rgb #x12 #x34 #x56) (color-parse "123456"))
  (check-equal? (make-rgb #x12 #x45 #x78) (color-parse "#123456789"))
  (check-equal? (make-rgb #x12 #x56 #x9a) (color-parse "#123456789abc"))
  (check-equal? (make-rgb 255 0 128) (color-parse " \trgb:ff/00/80\t"))
  (check-equal? (make-rgb 255 0 127) (color-parse "rgbi:1/0/0.5"))
  (check-equal? (make-rgb 34 139 34) (color-parse-x11 " forestGREEN "))
  (check-equal? (list 16 (make-rgb #x12 #x34 #x56))
    (call-with-values (lambda () (color-parse-palette-entry " 0x10 = #123456 ")) list))
  (check-equal? (list 255 (make-rgb 255 0 0))
    (call-with-values (lambda () (color-parse-palette-entry "0b11111111=red")) list))
  (check-equal? (list 16 (make-rgb #xaa #xbb #xcc))
    (call-with-values (lambda () (color-parse-palette-entry "0o20=#abc")) list)))

(test "text that is not a color"
  (for-each (lambda (text) (check-equal? #f (color-parse text)))
    (list "" "not a color" "red\x0;x" "界" "#abcd" "rgbi:2/0/0"))
  (check-equal? #f (color-parse-x11 "#abc"))
  (for-each
    (lambda (text)
      (check-equal? '(#f #f) (call-with-values (lambda () (color-parse-palette-entry text)) list)))
    '("256=red" "-1=red" "0x100=red" "1=" "red"))
  (check-raises assertion-violation? (color-parse 'red)))

(test "default and generated palettes"
  (let* ([base (color-default-palette)] [before (vector-copy base)]
         [indices '(16 63 64 127 128 191 192 255)])
    (check-equal? 256 (vector-length base))
    (check-equal? (make-rgb 0 0 0) (vector-ref base 16))
    (check-equal? (make-rgb 255 255 255) (vector-ref base 231))
    (check-equal? (make-rgb 8 8 8) (vector-ref base 232))
    (check-equal? (make-rgb 238 238 238) (vector-ref base 255))
    (for-each (lambda (i) (vector-set! base i (make-rgb 1 2 3))) indices)
    (let ([generated (color-generate-palette (make-rgb 0 0 0) (make-rgb 255 255 255) base indices)])
      (for-each (lambda (i) (check-equal? (make-rgb 1 2 3) (vector-ref generated i))) indices)
      (check-equal? (vector-ref before 0) (vector-ref generated 0))
      (check-equal? (vector-ref before 15) (vector-ref generated 15))
      (check (not (equal? (make-rgb 1 2 3) (vector-ref generated 17))))))
  (let* ([black (make-rgb 0 0 0)] [white (make-rgb 255 255 255)]
         [dark (color-generate-palette white black)]
         [light (color-generate-harmonious-palette white black)])
    (check-equal? (make-rgb 14 14 14) (vector-ref dark 232))
    (check-equal? (make-rgb 243 243 243) (vector-ref dark 255))
    (check-equal? (make-rgb 243 243 243) (vector-ref light 232))
    (check-equal? (make-rgb 14 14 14) (vector-ref light 255)))
  (let ([black (make-rgb 0 0 0)] [white (make-rgb 255 255 255)])
    (check-raises assertion-violation? (color-generate-palette black white (vector)))
    (check-raises assertion-violation? (color-generate-palette black white #f '(256)))
    (check-raises assertion-violation? (color-generate-palette black white #f '(-1)))))

(test "luminance and contrast"
  (let ([black (make-rgb 0 0 0)] [white (make-rgb 255 255 255)])
    (check-equal? 0.0 (color-luminance black))
    (check-equal? 1.0 (color-luminance white))
    (check-equal? 0.0 (color-perceived-luminance black))
    (check (< (abs (- (color-perceived-luminance white) 1.0)) 1e-12))
    (check-equal? 21.0 (color-contrast black white))
    (check-equal? 21.0 (color-contrast white black))
    (check-equal? 1.0 (color-contrast black black))
    (check (< (abs (- (color-luminance (make-rgb 255 0 0)) 0.2126)) 1e-6))
    (check-raises assertion-violation? (color-luminance '(0 0 0)))))

(test "the X11 color table"
  (let ([entries (color-x11-colors)])
    (check-equal? 782 (length entries))
    (check (for-all (lambda (entry) (equal? (cdr entry) (color-parse-x11 (car entry)))) entries))
    (check-equal? (make-rgb 34 139 34) (cdr (assoc "forest green" entries)))))

(test "reports"
  (check-equal? "\x1b;[?997;1n" (wire (color-scheme-report-encode 'dark)))
  (check-equal? "\x1b;[?997;2n" (wire (color-scheme-report-encode 'light)))
  (check-equal? "\x1b;[I" (wire (focus-encode 'gained)))
  (check-equal? "\x1b;[O" (wire (focus-encode 'lost)))
  (for-each
    (lambda (state number)
      (check-equal? (format "\x1b;[?25;~a$y" number) (wire (mode-report-encode 'cursor-visible state))))
    '(not-recognized set reset permanently-set permanently-reset) '(0 1 2 3 4))
  (check-equal? "\x1b;[4;1$y" (wire (mode-report-encode 'insert 'set)))
  (check-equal? "\x1b;[48;24;80;432;720t" (wire (size-report-encode 'mode-2048 (make-terminal-size 24 80 9 18))))
  (check-equal? "\x1b;[4;432;720t" (wire (size-report-encode 'csi-14-t (make-terminal-size 24 80 9 18))))
  (check-equal? "\x1b;[6;18;9t" (wire (size-report-encode 'csi-16-t (make-terminal-size 24 80 9 18))))
  (check-equal? "\x1b;[8;24;80t" (wire (size-report-encode 'csi-18-t (make-terminal-size 24 80 9 18))))
  (check-equal? "\x1b;[48;0;0;0;0t" (wire (size-report-encode 'mode-2048 (make-terminal-size 0 0 0 0))))
  (check-equal? "\x1b;[48;65535;65535;281470681677825;281470681677825t"
    (wire (size-report-encode 'mode-2048 (make-terminal-size 65535 65535 4294967295 4294967295))))
  (check-raises assertion-violation? (color-scheme-report-encode 'other))
  (check-raises assertion-violation? (focus-encode 'other))
  (check-raises assertion-violation? (mode-report-encode 'cursor-visible 'other))
  (check-raises assertion-violation? (size-report-encode 'other (make-terminal-size 1 1 1 1)))
  (check-raises assertion-violation? (size-report-encode 'mode-2048 (make-terminal-size 1 65536 1 1)))
  (check-raises assertion-violation? (size-report-encode 'mode-2048 (make-terminal-size 1 1 -1 1))))

(test "paste safety and encoding"
  (check (paste-safe? (bytevector)))
  (check (paste-safe? "plain"))
  (check (not (paste-safe? "one\ntwo")))
  (check (not (paste-safe? "\x1b;[201~")))
  (check-equal? (bytevector) (paste-encode (bytevector)))
  (check-equal? "\x1b;[200~\x1b;[201~" (wire (paste-encode-bracketed "")))
  (let* ([input (bytevector 97 10 0 27 98)] [before (bytevector-copy input)])
    (check-equal? "a\r  b" (wire (paste-encode input)))
    (check-equal? before input)
    (check-equal? "\x1b;[200~a\n  b\x1b;[201~" (wire (paste-encode-bracketed input)))
    (check-equal? before input))
  (check-equal? (bytevector 255 13 13 9) (paste-encode (bytevector 255 13 10 9)))
  (let ([input (make-bytevector 256)] [expected (make-bytevector 256)])
    (do ([i 0 (+ i 1)]) ((= i 256))
      (bytevector-u8-set! input i i)
      (bytevector-u8-set! expected i
        (cond
          [(memv i '(0 3 4 5 8 15 17 18 19 21 22 23 26 27 28 127)) 32]
          [(= i 10) 13]
          [else i])))
    (check-equal? expected (paste-encode input)))
  (let* ([input (make-bytevector 4096 97)])
    (bytevector-u8-set! input 300 10)
    (let ([output (paste-encode-bracketed input)])
      (check-equal? 4108 (bytevector-length output))
      (check-equal? 10 (bytevector-u8-ref output 306))))
  (check-raises assertion-violation? (paste-encode 'text)))

(test "Unicode widths"
  (for-each (lambda (codepoint width) (check-equal? width (unicode-codepoint-width codepoint)))
    '(0 97 #x301 #x200d #xfe0f #x4e00 #x1f642 #xd800 #x110000 #xffffffff)
    '(0 1 0 0 0 2 2 0 1 1))
  (check-raises assertion-violation? (unicode-codepoint-width -1))
  (check-raises assertion-violation? (unicode-codepoint-width 4294967296))
  (let ([measure (lambda (cps) (call-with-values (lambda () (unicode-grapheme-width cps)) list))])
    (check-equal? '(0 0) (measure '()))
    (check-equal? '(2 1) (measure '(97 #x301 98)))
    (check-equal? '(3 2) (measure '(#x1f469 #x200d #x1f4bb 97)))
    (check-equal? '(2 2) (measure '(#x2764 #xfe0f)))
    (check-equal? '(2 1) (measure '(#x2764 #xfe0e)))
    (check-equal? '(2 1) (measure '(97 #xfe0f)))
    (check-equal? '(2 2) (measure '(#x1f1fa #x1f1f8 #x1f1eb)))
    (check-equal? '(1 1) (measure '(#xffffffff #x301)))
    (check-equal? '(1 1) (measure '(97 #x110000)))
    (check-equal? '(2 1) (measure "e\x301;x"))
    (check-raises assertion-violation? (measure '(-1)))
    (check-raises assertion-violation? (measure '(4294967296)))))

(test "OSC payloads"
  (let ([input (bytes "0;hello 界")])
    (check-equal? "hello 界" (osc-command-data (osc-parse input)))
    (check-equal? 'change-window-title (osc-command-kind (osc-parse input 'st))))
  (check-equal? "again" (osc-command-data (osc-parse "2;again")))
  (for-each (lambda (input) (check-equal? 'invalid (osc-command-kind (osc-parse input 'st))))
    '("" "8;incomplete"))
  (check-equal? 'unknown (osc-command-kind (osc-parse "not-a-number")))
  (check-equal? "" (osc-command-data (osc-parse "0;")))
  (for-each
    (lambda (sample)
      (let ([command (osc-parse (car sample))])
        (check-equal? (cdr sample) (osc-command-kind command))
        (check-equal? #f (osc-command-data command))))
    '(("1;icon" . change-window-icon) ("7;file://host/dir" . report-pwd)
      ("8;id=a;https://example.test" . hyperlink-start) ("8;;" . hyperlink-end)
      ("10;#aabbcc" . color-operation) ("22;pointer" . mouse-shape)
      ("52;c;aGVsbG8=" . clipboard-contents) ("133;A" . semantic-prompt)))
  (let ([unknown (osc-parse "7400;status=busy")])
    (check-equal? 'unknown (osc-command-kind unknown))
    (check-equal? (bytes "7400;status=busy") (osc-command-data unknown)))
  (check-equal? "a" (osc-command-data (osc-parse (bytevector 48 59 97 0 98))))
  (check-raises assertion-violation? (osc-parse "0;x" 'esc)))

(test "SGR attributes"
  (check-equal? (list (cons 'bold #f) (cons 'fg-8 1))
    (map (lambda (a) (cons (sgr-attribute-kind a) (sgr-attribute-value a))) (sgr-parse '(1 31))))
  (check-equal? '(unset) (map sgr-attribute-kind (sgr-parse '())))
  (for-each
    (lambda (sample)
      (check-equal? (list (cdr sample)) (map sgr-attribute-kind (sgr-parse (list (car sample))))))
    '((0 . unset) (1 . bold) (22 . reset-bold) (3 . italic) (23 . reset-italic) (2 . faint)
      (59 . reset-underline-color) (53 . overline) (55 . reset-overline) (5 . blink) (6 . blink)
      (25 . reset-blink) (7 . inverse) (27 . reset-inverse) (8 . invisible) (28 . reset-invisible)
      (9 . strikethrough) (29 . reset-strikethrough) (39 . reset-fg) (49 . reset-bg)))
  (let loop ([styles '(none single double curly dotted dashed)] [n 0])
    (unless (null? styles)
      (check-equal? (list (car styles)) (map sgr-attribute-value (sgr-parse (list 4 n) ":;")))
      (loop (cdr styles) (+ n 1))))
  (check-equal? '(double) (map sgr-attribute-value (sgr-parse '(21))))
  (for-each
    (lambda (sample)
      (let ([a (car (sgr-parse (list (car sample) 2 10 20 30)))])
        (check-equal? (cdr sample) (sgr-attribute-kind a))
        (check-equal? (make-rgb 10 20 30) (sgr-attribute-value a))))
    '((38 . direct-color-fg) (48 . direct-color-bg) (58 . underline-color)))
  (check-equal? (make-rgb 10 20 30)
    (sgr-attribute-value (car (sgr-parse '(38 2 0 10 20 30) ":::::;"))))
  (check-equal? (make-rgb 44 2 255) (sgr-attribute-value (car (sgr-parse '(38 2 300 2 65535)))))
  (do ([i 0 (+ i 1)]) ((= i 8))
    (for-each
      (lambda (sample)
        (let ([a (car (sgr-parse (list (+ (car sample) i))))])
          (check-equal? (cadr sample) (sgr-attribute-kind a))
          (check-equal? (+ i (caddr sample)) (sgr-attribute-value a))))
      '((30 fg-8 0) (40 bg-8 0) (90 bright-fg-8 8) (100 bright-bg-8 8))))
  (for-each
    (lambda (sample)
      (for-each
        (lambda (value)
          (let ([a (car (sgr-parse (list (car sample) 5 value)))])
            (check-equal? (cdr sample) (sgr-attribute-kind a))
            (check-equal? (modulo value 256) (sgr-attribute-value a))))
        '(0 255 65535)))
    '((38 . fg-256) (48 . bg-256) (58 . underline-color-256)))
  (let ([unknown (sgr-attribute-value (cadr (sgr-parse '(1 38 2 9))))])
    (check-equal? '(1 38 2 9) (sgr-unknown-full unknown))
    (check-equal? '(38 2 9) (sgr-unknown-partial unknown)))
  (check-raises assertion-violation? (sgr-parse '(65536)))
  (check-raises assertion-violation? (sgr-parse '(1) ";;"))
  (check-raises ghostty-error? (sgr-parse (make-list 4096 1) (make-string 4096 #\;)))
  (check-equal? 4096 (length (sgr-parse (make-list 4096 1)))))

(test-exit)
