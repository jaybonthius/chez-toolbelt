(import (chezscheme) (ghostty) (check))

(define (bytes s) (string->utf8 s))

(define-syntax with-terminal
  (syntax-rules ()
    [(_ (t columns rows) body ...)
     (let ([t (make-terminal columns rows)])
       (dynamic-wind void (lambda () body ...) (lambda () (terminal-close! t))))]))

(define (capture-pty! t)
  (let ([out '()])
    (terminal-set-pty-write-handler! t (lambda (bv) (set! out (cons bv out))))
    (lambda ()
      (let ([all (apply string-append (map utf8->string (reverse out)))])
        (set! out '())
        all))))

(define (raised thunk)
  (call/cc (lambda (k) (with-exception-handler (lambda (c) (k (list 'raised c))) thunk))))

(define (raised-by? who)
  (lambda (c) (and (assertion-violation? c) (who-condition? c) (eq? who (condition-who c)))))

(define (string-search needle haystack)
  (let ([n (string-length needle)] [h (string-length haystack)])
    (let loop ([i 0])
      (cond
        [(> (+ i n) h) #f]
        [(string=? needle (substring haystack i (+ i n))) i]
        [else (loop (+ i 1))]))))

(test "replies to queries go to the pty handler in order"
  (with-terminal (t 20 3)
    (let ([pty (capture-pty! t)])
      (terminal-write! t (bytes "ab\x1b;[6n\x1b;[c"))
      (check-equal? "\x1b;[1;3R\x1b;[?62;22c" (pty))
      (terminal-set-pty-write-handler! t #f)
      (terminal-write! t (bytes "\x1b;[6n"))
      (check-equal? "" (pty)))))

(test "a handler's raise waits for the write to finish, and later writes work"
  (with-terminal (t 20 2)
    (let ([first (list 'first)] [calls 0])
      (terminal-set-bell-handler! t
        (lambda ()
          (set! calls (+ calls 1))
          (raise (if (= calls 1) first 'later))))
      (let ([outcome (raised (lambda () (terminal-write! t (bytevector 7 7 65))))])
        (check-equal? 'raised (car outcome))
        (check (eq? first (cadr outcome))))
      (check-equal? 2 calls)
      (check-equal? "A" (terminal->string t))
      (terminal-set-bell-handler! t (lambda () (raise #f)))
      (check-equal? '(raised #f) (raised (lambda () (terminal-write! t (bytevector 7)))))
      (terminal-set-bell-handler! t #f)
      (terminal-write! t (bytevector 7 66))
      (check-equal? "AB" (terminal->string t)))))

(test "enquiry and version replies"
  (with-terminal (t 20 2)
    (let ([pty (capture-pty! t)])
      (terminal-write! t (bytevector 5))
      (check-equal? "" (pty))
      (terminal-set-enquiry-handler! t (lambda () (bytevector 0 1 2)))
      (terminal-write! t (bytevector 5))
      (check-equal? (utf8->string (bytevector 0 1 2)) (pty))
      (terminal-set-enquiry-handler! t (lambda () "answer"))
      (terminal-write! t (bytevector 5 5))
      (check-equal? "answeranswer" (pty))
      (terminal-write! t (bytes "\x1b;[>q"))
      (check-equal? "\x1b;P>|libghostty\x1b;\\" (pty))
      (terminal-set-xtversion-handler! t (lambda () "myterm 1.0"))
      (terminal-write! t (bytes "\x1b;[>q"))
      (check-equal? "\x1b;P>|myterm 1.0\x1b;\\" (pty))
      (terminal-set-xtversion-handler! t (lambda () 'not-bytes))
      (check-raises assertion-violation? (terminal-write! t (bytes "\x1b;[>q")))
      (check-equal? "\x1b;P>|libghostty\x1b;\\" (pty)))))

(test "title and working-directory changes carry the new value"
  (with-terminal (t 20 2)
    (let ([titles '()] [pwds '()])
      (terminal-set-title-changed-handler! t (lambda (title) (set! titles (cons title titles))))
      (terminal-set-pwd-changed-handler! t (lambda (pwd) (set! pwds (cons pwd pwds))))
      (terminal-write! t (bytes "\x1b;]0;one\x7;\x1b;]2;two\x1b;\\\x1b;]7;file:///tmp\x7;"))
      (check-equal? '("two" "one") titles)
      (check-equal? '("file:///tmp") pwds))))

(test "size, color-scheme and device-attribute queries"
  (with-terminal (t 20 2)
    (let ([pty (capture-pty! t)])
      (terminal-write! t (bytes "\x1b;[18t"))
      (check-equal? "" (pty))
      (terminal-set-size-handler! t (lambda () (make-terminal-size 24 80 10 20)))
      (terminal-write! t (bytes "\x1b;[18t\x1b;[14t"))
      (check-equal? "\x1b;[8;24;80t\x1b;[4;480;800t" (pty))
      (terminal-set-size-handler! t (lambda () #f))
      (terminal-write! t (bytes "\x1b;[18t"))
      (check-equal? "" (pty))
      (terminal-set-size-handler! t (lambda () (make-terminal-size 70000 80 10 20)))
      (check-raises assertion-violation? (terminal-write! t (bytes "\x1b;[18t")))
      (check-equal? "" (pty))
      (terminal-set-color-scheme-handler! t (lambda () 'dark))
      (terminal-write! t (bytes "\x1b;[?996n"))
      (check-equal? "\x1b;[?997;1n" (pty))
      (terminal-set-color-scheme-handler! t (lambda () 'light))
      (terminal-write! t (bytes "\x1b;[?996n"))
      (check-equal? "\x1b;[?997;2n" (pty))
      (terminal-set-color-scheme-handler! t (lambda () #f))
      (terminal-write! t (bytes "\x1b;[?996n"))
      (check-equal? "" (pty))
      (terminal-set-device-attributes-handler! t
        (lambda () (make-device-attributes 64 '(1 22) 41 10 0 #x12345678)))
      (terminal-write! t (bytes "\x1b;[c\x1b;[>c\x1b;[=c"))
      (check-equal? "\x1b;[?64;1;22c\x1b;[>41;10;0c\x1b;P!|12345678\x1b;\\" (pty))
      (check-raises assertion-violation? (make-device-attributes 64 (iota 65) 41 10 0 0)))))

(test "an invalid handler answer is held like a raise"
  (with-terminal (t 20 2)
    (let ([pty (capture-pty! t)])
      (terminal-set-size-handler! t (lambda () 'nonsense))
      (check-raises (raised-by? 'terminal-set-size-handler!) (terminal-write! t (bytes "\x1b;[18t")))
      (check-equal? "" (pty))
      (terminal-set-color-scheme-handler! t (lambda () 'purple))
      (check-raises (raised-by? 'terminal-set-color-scheme-handler!)
        (terminal-write! t (bytes "\x1b;[?996n")))
      (check-equal? "" (pty))
      (terminal-set-enquiry-handler! t (lambda () 42))
      (check-raises (raised-by? 'terminal-set-enquiry-handler!) (terminal-write! t (bytes "\x5;")))
      (terminal-set-device-attributes-handler! t (lambda () 'none))
      (check-raises (raised-by? 'terminal-set-device-attributes-handler!)
        (terminal-write! t (bytes "\x1b;[c")))
      (terminal-set-clipboard-write-handler! t (lambda (request) 'maybe))
      (check-raises (raised-by? 'terminal-set-clipboard-write-handler!)
        (terminal-write! t (bytes "\x1b;]52;c;aGVsbG8=\x7;"))))))

(test "operations name themselves when given something that is not a terminal"
  (check-raises (raised-by? 'terminal-reset!) (terminal-reset! 5))
  (check-raises (raised-by? 'terminal-resize!) (terminal-resize! 5 10 10))
  (check-raises (raised-by? 'terminal-paste!) (terminal-paste! 5 "x"))
  (check-raises (raised-by? 'terminal-write!) (terminal-write! 5 (bytevector 65))))

(test "clipboard writes carry every representation"
  (with-terminal (t 20 2)
    (let ([requests '()])
      (terminal-set-clipboard-write-handler! t
        (lambda (request) (set! requests (cons request requests)) 'success))
      (terminal-write! t (bytes "\x1b;]52;c;aGVsbG8=\x7;"))
      (let ([request (car requests)])
        (check-equal? 'standard (clipboard-write-request-location request))
        (check-equal? (list (make-clipboard-content "text/plain" (bytes "hello")))
          (clipboard-write-request-contents request))
        (check (not (clipboard-write-request-granted? request))))
      (terminal-write! t (bytes "\x1b;]52;p;\x7;"))
      (check-equal? 'primary (clipboard-write-request-location (car requests)))
      (check-equal? '() (clipboard-write-request-contents (car requests)))
      (terminal-set-clipboard-write-handler! t (lambda (request) (values 'denied #t)))
      (terminal-write! t (bytes "\x1b;]52;c;aGVsbG8=\x7;"))
      (terminal-set-clipboard-write-handler! t (lambda (request) 'maybe))
      (check-raises assertion-violation? (terminal-write! t (bytes "\x1b;]52;c;aGVsbG8=\x7;"))))))

(test "clipboard reads are answered by the handler"
  (with-terminal (t 20 2)
    (let ([pty (capture-pty! t)] [requests '()])
      (terminal-write! t (bytes "\x1b;]52;c;?\x7;"))
      (check-equal? "" (pty))
      (terminal-set-clipboard-read-handler! t
        (lambda (request)
          (set! requests (cons request requests))
          (list (make-clipboard-content "text/plain" (bytes "hi")))))
      (terminal-write! t (bytes "\x1b;]52;c;?\x7;"))
      (check-equal? "\x1b;]52;c;aGk=\x7;" (pty))
      (check-equal? 'standard (clipboard-read-request-location (car requests)))
      (check-equal? '("text/plain") (clipboard-read-request-mimes (car requests)))
      (terminal-set-clipboard-read-handler! t (lambda (request) 'denied))
      (terminal-write! t (bytes "\x1b;]52;c;?\x7;"))
      (check-equal? "\x1b;]52;c;\x7;" (pty))
      (terminal-set-clipboard-read-handler! t (lambda (request) (raise 'no)))
      (check-equal? '(raised no) (raised (lambda () (terminal-write! t (bytes "\x1b;]52;c;?\x7;")))))
      (check-equal? "\x1b;]52;c;\x7;" (pty)))))

(test "notifications and progress reports"
  (with-terminal (t 20 2)
    (let ([notes '()] [progress '()])
      (terminal-set-desktop-notification-handler! t (lambda (n) (set! notes (cons n notes))))
      (terminal-set-progress-report-handler! t (lambda (p) (set! progress (cons p progress))))
      (terminal-write! t (bytes "\x1b;]9;hello\x7;\x1b;]777;notify;Title;Body\x7;"))
      (check-equal? '(("Title" . "Body") ("" . "hello"))
        (map (lambda (n) (cons (desktop-notification-title n) (desktop-notification-body n)))
             notes))
      (terminal-write! t (bytes "\x1b;]9;4;1;50\x7;\x1b;]9;4;3\x7;\x1b;]9;4;0\x7;"))
      (check-equal? '((remove . #f) (indeterminate . #f) (set . 50))
        (map (lambda (p) (cons (progress-report-state p) (progress-report-progress p))) progress)))))

(test "unknown sequences need a byte limit and report their terminator"
  (with-terminal (t 20 2)
    (let ([seen '()])
      (terminal-set-unknown-sequence-handler! t (lambda (s) (set! seen (cons s seen))))
      (terminal-write! t (bytes "\x1b;]7400;status=busy\x7;"))
      (check-equal? '() seen)
      (terminal-set-unknown-max-bytes! t 8)
      (terminal-write! t (bytes "\x1b;]7400;a\x7;\x1b;]7400;status=busy\x1b;\\"))
      (check-equal? 2 (length seen))
      (let ([short (cadr seen)] [long (car seen)])
        (check-equal? 'osc (unknown-sequence-kind short))
        (check-equal? (bytes "7400;a") (unknown-sequence-content short))
        (check (not (unknown-sequence-truncated? short)))
        (check-equal? 'bel (unknown-sequence-terminator short))
        (check-equal? (bytes "7400;sta") (unknown-sequence-content long))
        (check (unknown-sequence-truncated? long))
        (check-equal? 'st (unknown-sequence-terminator long)))
      (terminal-write! t (bytes "\x1b;_zz\x1b;\\"))
      (check-equal? 'apc (unknown-sequence-kind (car seen)))
      (check-equal? #f (unknown-sequence-terminator (car seen))))))

(test "semantic prompts report each step of a command"
  (with-terminal (t 20 3)
    (let ([events '()])
      (terminal-set-semantic-prompt-handler! t (lambda (e) (set! events (cons e events))))
      (terminal-write! t (bytes "\x1b;]133;A\x7;$ \x1b;]133;B\x7;ls\r\n\x1b;]133;C\x7;out\r\n\x1b;]133;D;2\x7;"))
      (check-equal? '(prompt-start input-start output-start command-end)
        (reverse (map semantic-prompt-kind events)))
      (check-equal? 'primary (semantic-prompt-prompt-kind (list-ref events 3)))
      (check-equal? 2 (semantic-prompt-exit-code (car events)))
      (check-equal? #f (semantic-prompt-exit-code (cadr events))))))

(test "program status reports"
  (with-terminal (t 20 3)
    (let ([pty (capture-pty! t)] [reports '()])
      (terminal-write! t (bytes "\x1b;]7501;?\x1b;\\"))
      (check-equal? "" (pty))
      (terminal-set-program-status-handler! t (lambda (r) (set! reports (cons r reports))))
      (terminal-write! t (bytes "\x1b;]7501;?\x1b;\\"))
      (check (string=? "\x1b;]7501;?:" (substring (pty) 0 9)))
      (terminal-write! t (bytes "\x1b;]7501;state=blocked:kind=permission:app=terraform:msg=QXBwbHk/\x1b;\\"))
      (let ([r (car reports)])
        (check-equal? 'blocked (program-status-state r))
        (check-equal? 'permission (program-status-kind r))
        (check-equal? #f (program-status-progress r))
        (check-equal? "" (program-status-id r))
        (check-equal? "terraform" (program-status-app r))
        (check-equal? "Apply?" (program-status-message r)))
      (terminal-write! t (bytes "\x1b;]7501;state=working:progress=40:id=build\x1b;\\"))
      (check-equal? 40 (program-status-progress (car reports)))
      (check-equal? "build" (program-status-id (car reports)))
      (terminal-write! t (bytes "\x1b;c"))
      (check-equal? 'clear (program-status-state (car reports))))))

(test "resize requests, resets and render holds"
  (with-terminal (t 20 3)
    (let ([sizes '()] [resets 0] [holds '()])
      (terminal-set-resize-window-handler! t (lambda (rows columns) (set! sizes (cons (cons rows columns) sizes))))
      (terminal-set-reset-handler! t (lambda () (set! resets (+ resets 1))))
      (terminal-set-render-hold-handler! t (lambda (held?) (set! holds (cons held? holds))))
      (terminal-write! t (bytes "\x1b;[8;24;80t\x1b;[8;0;100t"))
      (check-equal? '((0 . 100) (24 . 80)) sizes)
      (terminal-write! t (bytes "\x1b;c"))
      (check-equal? 1 resets)
      (terminal-write! t (bytes "\x1b;[?2026h\x1b;[?2026h\x1b;[?2026l"))
      (check-equal? '(#f #t) holds)
      (terminal-write! t (bytes "\x1b;[?2026h"))
      (terminal-resize! t 30 4)
      (check-equal? '(#f #t #f #t) holds)
      (terminal-write! t (bytes "\x1b;[?2026h"))
      (terminal-reset! t)
      (check-equal? '(#f #t #f #t #f #t) holds))))

(test "reads work inside a callback; changes are refused"
  (with-terminal (t 20 3)
    (let ([seen #f] [refused #f] [other (make-terminal 5 2)])
      (terminal-set-title-changed-handler! t
        (lambda (title)
          (set! seen (list title (terminal-title t) (terminal->string t)))
          (terminal-write! other (bytes "ok"))
          (set! refused
            (list (guard (c [(assertion-violation? c) 'refused]) (terminal-write! t (bytes "x")))
                  (guard (c [(assertion-violation? c) 'refused]) (terminal-resize! t 5 5))
                  (guard (c [(assertion-violation? c) 'refused]) (terminal-set-title! t "y"))
                  (guard (c [(assertion-violation? c) 'refused]) (terminal-close! t))))
          (terminal-set-title-changed-handler! t #f)))
      (terminal-write! t (bytes "abc\x1b;]2;T\x7;def"))
      (check-equal? '("T" "T" "abc") seen)
      (check-equal? '(refused refused refused refused) refused)
      (check-equal? "abcdef" (terminal->string t))
      (check-equal? "ok" (terminal->string other))
      (terminal-close! other))))

(test "a continuation escaping a handler leaves the terminal unusable, not corrupt"
  (let ([t (make-terminal 20 3)])
    (let ([escaped
           (call/cc
             (lambda (k)
               (terminal-set-bell-handler! t (lambda () (k 'escaped)))
               (terminal-write! t (bytevector 65 7 66))
               'returned))])
      (check-equal? 'escaped escaped)
      (check-raises assertion-violation? (terminal->string t))
      (check-raises assertion-violation? (terminal-write! t (bytevector 65)))
      (check-raises assertion-violation? (terminal-close! t))
      (check (not (terminal-closed? t)))))
  (let ([t (make-terminal 20 3)] [input (bytevector 65 7 66)])
    (call/cc
      (lambda (k)
        (terminal-set-bell-handler! t (lambda () (k 'escaped)))
        (terminal-write! t input)))
    (check (not (locked-object? input)))))

;; Each handler reads the other terminal while the other thread may hold
;; it inside its own callback; waiting there would deadlock both threads.
(test "two terminals reading each other inside callbacks on two threads do not deadlock"
  (let* ([a (make-terminal 20 5)] [b (make-terminal 20 5)]
         [m (make-mutex)] [done (make-condition)] [finished 0] [refused 0] [other 0])
    (terminal-set-bell-handler! a (lambda () (terminal->string b)))
    (terminal-set-bell-handler! b (lambda () (terminal->string a)))
    (for-each
      (lambda (t)
        (fork-thread
          (lambda ()
            (do ([i 0 (+ i 1)]) ((= i 20000))
              (guard (c [(assertion-violation? c) (with-mutex m (set! refused (+ refused 1)))]
                        [#t (with-mutex m (set! other (+ other 1)))])
                (terminal-write! t (bytes "\x7;"))))
            (with-mutex m
              (set! finished (+ finished 1))
              (condition-signal done)))))
      (list a b))
    (with-mutex m
      (let wait ()
        (when (and (< finished 2)
                   (condition-wait done m (add-duration (current-time 'time-utc)
                                            (make-time 'time-duration 0 60))))
          (wait))))
    (check-equal? 2 finished)
    (check-equal? 0 other)
    (when (= finished 2)
      (terminal-close! a)
      (terminal-close! b))))

(test "pasting text follows bracketed-paste mode and refuses unsafe text"
  (with-terminal (t 20 3)
    (check-raises (lambda (c) (and (ghostty-error? c) (eq? (ghostty-error-result c) 'invalid-value)))
      (terminal-paste! t "x"))
    (let ([pty (capture-pty! t)])
      (check-equal? 'written (terminal-paste! t "hello"))
      (check-equal? "hello" (pty))
      (check-equal? 'rejected (terminal-paste! t "rm -rf /\n"))
      (check-equal? "" (pty))
      (check-equal? 'written (terminal-paste-unsafe! t "a\nb"))
      (check-equal? "a\rb" (pty))
      (terminal-write! t (bytes "\x1b;[?2004h"))
      (check-equal? 'written (terminal-paste! t "a\nb"))
      (check-equal? "\x1b;[200~a\nb\x1b;[201~" (pty))
      (check-equal? 'empty (terminal-paste! t ""))
      (check-equal? 'empty (terminal-paste! t (list (make-clipboard-content "image/png" (bytevector 1 2)))))
      (check-equal? 'written
        (terminal-paste! t (list (make-clipboard-content "image/png" (bytevector 1 2))
                                 (make-clipboard-content "text/plain" (bytes "two")))))
      (check-equal? "\x1b;[200~two\x1b;[201~" (pty))
      (check-raises assertion-violation? (terminal-paste! t 42))
      (check-raises (raised-by? 'terminal-paste!) (terminal-paste! t "x" 'nowhere))
      (check-raises (raised-by? 'terminal-paste!) (terminal-paste! t "x" 'standard 'keyboard)))))

(test "pastes carry their clipboard location and source into paste events"
  (with-terminal (t 20 3)
    (let ([pty (capture-pty! t)])
      (terminal-set-clipboard-read-handler! t (lambda (request) 'denied))
      (terminal-write! t (bytes "\x1b;[?5522h"))
      (check-equal? 'written (terminal-paste! t "hello"))
      (let ([event (pty)])
        (check (string-search "type=read:status=OK:pw=" event))
        (check (not (string-search "hello" event))))
      (check-equal? 'written (terminal-paste! t "hello" 'primary))
      (check (string-search "type=read:status=OK:loc=primary:" (pty)))
      (check-equal? 'written (terminal-paste-unsafe! t "hello" 'primary 'clipboard))
      (check (string-search "loc=primary" (pty)))
      (check-equal? 'written (terminal-paste! t "hello" 'standard 'text))
      (check-equal? "hello" (pty)))))

(test-exit)
