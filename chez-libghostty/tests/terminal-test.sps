(import (chezscheme) (ghostty) (check))

(define (bytes . parts)
  (apply bytevector-append
    (map (lambda (part) (if (string? part) (string->utf8 part) (apply bytevector part))) parts)))

(define (bytevector-append . bvs)
  (let ([out (make-bytevector (apply + (map bytevector-length bvs)))])
    (let loop ([bvs bvs] [i 0])
      (if (null? bvs)
          out
          (begin
            (bytevector-copy! (car bvs) 0 out i (bytevector-length (car bvs)))
            (loop (cdr bvs) (+ i (bytevector-length (car bvs)))))))))

(define (subbytevector bv start end)
  (let ([out (make-bytevector (- end start))])
    (bytevector-copy! bv start out 0 (- end start))
    out))

(define-syntax with-terminal
  (syntax-rules ()
    [(_ (t columns rows) body ...)
     (let ([t (make-terminal columns rows)])
       (dynamic-wind void (lambda () body ...) (lambda () (terminal-close! t))))]))

(define (ghostty-error-with result)
  (lambda (c) (and (ghostty-error? c) (eq? (ghostty-error-result c) result))))

(test "build information comes from the library"
  (let ([info (libghostty-build-info)])
    (check-equal? "0.1.0-dev" (build-info-version info))
    (check-equal? 0 (build-info-major info))
    (check-equal? 1 (build-info-minor info))
    (check-equal? 0 (build-info-patch info))
    (check-equal? "dev" (build-info-pre info))
    (check-equal? 'release-fast (build-info-optimize info))
    (check (build-info-kitty-graphics? info))))

(test "styled text reads back as plain text"
  (with-terminal (t 20 2)
    (terminal-write! t (bytes "plain \x1b;[1;31mstyled\x1b;[0m"))
    (check-equal? "plain styled" (terminal->string t))
    (check (terminal? t))
    (check (not (terminal? 'terminal)))))

(test "empty writes and embedded NUL bytes"
  (with-terminal (t 10 2)
    (terminal-write! t (bytevector))
    (check-equal? "" (terminal->string t))
    (terminal-write! t (bytevector 65 0 66))
    (check-equal? "AB" (terminal->string t))))

(test "every cut of a UTF-8 sequence keeps the decoder's state"
  (let ([text (bytes "界🙂é")])
    (do ([cut 1 (+ cut 1)]) ((= cut (bytevector-length text)))
      (with-terminal (t 20 2)
        (terminal-write! t (subbytevector text 0 cut))
        (collect)
        (terminal-write! t (subbytevector text cut (bytevector-length text)))
        (check-equal? "界🙂é" (terminal->string t))
        (check (terminal-vt-ground? t))))))

(test "writing until ground consumes the shortest prefix"
  (with-terminal (t 20 2)
    (let-values ([(n ground?) (terminal-write-until-ground! t (bytevector 88))])
      (check-equal? 0 n)
      (check ground?))
    (terminal-write! t (bytevector 27 91 51 49))
    (check (not (terminal-vt-ground? t)))
    (let-values ([(n ground?) (terminal-write-until-ground! t (bytevector 109 65 66 67 27 91))])
      (check-equal? 1 n)
      (check ground?)
      (check-equal? "" (terminal->string t)))
    (terminal-write! t (bytevector 65 66 67 27 91))
    (let-values ([(n ground?) (terminal-write-until-ground! t (bytevector 49 50 51))])
      (check-equal? 3 n)
      (check (not ground?)))
    (let-values ([(n ground?) (terminal-write-until-ground! t (bytevector))])
      (check-equal? 0 n)
      (check (not ground?)))
    (let-values ([(n ground?) (terminal-write-until-ground! t (bytevector 24 88))])
      (check-equal? 1 n)
      (check ground?))
    (check-equal? "ABC" (terminal->string t))))

(test "a split UTF-8 character counts bytes, not characters"
  (with-terminal (t 10 2)
    (terminal-write! t (bytevector 240))
    (let-values ([(n ground?) (terminal-write-until-ground! t (bytevector 159 152 132 88))])
      (check-equal? 3 n)
      (check ground?))
    (check-equal? (utf8->string (bytevector 240 159 152 132)) (terminal->string t))))

(test "slices write only the requested bytes"
  (with-terminal (t 20 2)
    (terminal-write! t (bytevector 88 65 0 66 89) 1 4)
    (check-equal? "AB" (terminal->string t))
    (terminal-write! t (bytevector 88 27 91 51 49 89) 1 5)
    (let-values ([(n ground?) (terminal-write-until-ground! t (bytevector 88 109 67 89) 1 3)])
      (check-equal? 1 n)
      (check ground?))
    (check-equal? "AB" (terminal->string t))
    (check-raises assertion-violation? (terminal-write! t (bytevector 88) 1 0))
    (check-raises assertion-violation? (terminal-write-until-ground! t (bytevector 88) 0 2))
    (check-raises assertion-violation? (terminal-write! t "text"))))

(test "resize reflows and reset keeps the size"
  (with-terminal (t 10 3)
    (terminal-write! t (bytes "abcdefghijABCDEFGHIJ"))
    (check-equal? "abcdefghij\nABCDEFGHIJ" (terminal->string t))
    (terminal-resize! t 5 4 8 16)
    (check-equal? "abcde\nfghij\nABCDE\nFGHIJ" (terminal->string t))
    (check-equal? 5 (terminal-columns t))
    (check-equal? 4 (terminal-rows t))
    (check-equal? 40 (terminal-pixel-width t))
    (check-equal? 64 (terminal-pixel-height t))
    (terminal-reset! t)
    (check-equal? "" (terminal->string t))
    (terminal-write! t (bytes "123456"))
    (check-equal? "12345\n6" (terminal->string t))))

(test "dimensions are checked before they reach C"
  (check-raises assertion-violation? (make-terminal 0 2))
  (check-raises assertion-violation? (make-terminal -1 2))
  (check-raises assertion-violation? (make-terminal 65536 2))
  (check-raises assertion-violation? (make-terminal 2.0 2))
  (with-terminal (t 5 2)
    (check-raises assertion-violation? (terminal-resize! t 5 0))
    (check-raises assertion-violation? (terminal-resize! t 5 2 -1 0))
    (check-raises assertion-violation? (terminal-resize! t 5 2 0 4294967296))
    (terminal-write! t (bytevector 88))
    (check-equal? "X" (terminal->string t))))

(test "a closed terminal refuses every operation"
  (let ([t (make-terminal 5 2)])
    (terminal-close! t)
    (terminal-close! t)
    (check (terminal-closed? t))
    (check-raises assertion-violation? (terminal-reset! t))
    (check-raises assertion-violation? (terminal-resize! t 5 2))
    (check-raises assertion-violation? (terminal-write! t (bytevector)))
    (check-raises assertion-violation? (terminal-write! t (bytevector 65)))
    (check-raises assertion-violation? (terminal-write-until-ground! t (bytevector 65)))
    (check-raises assertion-violation? (terminal-vt-ground? t))
    (check-raises assertion-violation? (terminal->string t))
    (check-raises assertion-violation? (terminal-set-title! t "x"))
    (check-raises assertion-violation? (terminal-set-bell-handler! t void))
    (check-raises assertion-violation? (terminal-cursor t))))

(test "writes from two threads are whole"
  (with-terminal (t 200 2)
    (let* ([a (fork-thread (lambda () (terminal-write! t (make-bytevector 64 65))))]
           [b (fork-thread (lambda () (terminal-write! t (make-bytevector 64 66))))])
      (thread-join a)
      (thread-join b)
      (check (member (terminal->string t)
               (list (string-append (make-string 64 #\A) (make-string 64 #\B))
                     (string-append (make-string 64 #\B) (make-string 64 #\A))))))))

(test "closing while another thread writes ends complete or closed"
  (do ([n 0 (+ n 1)]) ((= n 20))
    (let* ([t (make-terminal 80 24)]
           [outcome #f]
           [worker (fork-thread
                     (lambda ()
                       (set! outcome
                         (guard (c [(assertion-violation? c) 'closed])
                           (terminal-write! t (make-bytevector 65536 120))
                           (terminal->string t)
                           'complete))))])
      (terminal-close! t)
      (thread-join worker)
      (check (memq outcome '(complete closed))))))

(test "continuation tracking: limits, loss and recovery"
  (with-terminal (t 20 2)
    (check-equal? 0 (terminal-continuation-max-bytes t))
    (check-raises (ghostty-error-with 'invalid-value) (terminal-continuation t))
    (terminal-set-continuation-max-bytes! t 18446744073709551615)
    (check-equal? 18446744073709551615 (terminal-continuation-max-bytes t))
    (check-equal? (bytevector) (terminal-continuation t))
    (terminal-set-continuation-max-bytes! t 5)
    (terminal-write! t (bytevector 27 91 49 50 51))
    (check-equal? (bytevector 27 91 49 50 51) (terminal-continuation t))
    (terminal-write! t (bytevector 52))
    (check-raises (ghostty-error-with 'invalid-value) (terminal-continuation t))
    (terminal-set-continuation-max-bytes! t 8)
    (check-raises ghostty-error? (terminal-continuation t))
    (terminal-write! t (bytevector 109))
    (check-equal? (bytevector) (terminal-continuation t))
    (terminal-write! t (bytevector 27 91))
    (check-equal? (bytevector 27 91) (terminal-continuation t))
    (check-raises assertion-violation? (terminal-set-continuation-max-bytes! t -1))
    (check-raises assertion-violation? (terminal-set-continuation-max-bytes! t (expt 2 64)))))

(test "a continuation replays into another terminal"
  (with-terminal (source 20 2)
    (with-terminal (replay 20 2)
      (terminal-set-continuation-max-bytes! source 64)
      (terminal-write! source (bytevector 27 91 49 59 51 49))
      (let ([copy (terminal-continuation source)])
        (terminal-write! replay copy)
        (bytevector-u8-set! copy 0 88)
        (check-equal? (bytevector 27 91 49 59 51 49) (terminal-continuation source)))
      (terminal-write! source (bytevector 109 65))
      (terminal-write! replay (bytevector 109 65))
      (terminal-write! source (bytevector 240 159))
      (terminal-write! replay (terminal-continuation source))
      (terminal-write! source (bytevector 152 132))
      (terminal-write! replay (bytevector 152 132))
      (check-equal? (terminal->string source) (terminal->string replay))
      (check-equal? (terminal-format source 'vt (format-options style))
        (terminal-format replay 'vt (format-options style))))))

(test "Kitty limits apply to both screens"
  (with-terminal (t 10 5)
    (check-equal? 10000000 (terminal-kitty-image-storage-limit t))
    (terminal-set-kitty-image-storage-limit! t 12345)
    (check-equal? 12345 (terminal-kitty-image-storage-limit t))
    (terminal-write! t (bytes "\x1b;[?1049h"))
    (check-equal? 'alternate (terminal-active-screen t))
    (check-equal? 12345 (terminal-kitty-image-storage-limit t))
    (terminal-write! t (bytes "\x1b;[?1049l"))
    (terminal-set-kitty-image-storage-limit! t 0)
    (check-equal? 0 (terminal-kitty-image-storage-limit t))
    (terminal-set-kitty-image-storage-limit! t 18446744073709551615)
    (check-equal? 18446744073709551615 (terminal-kitty-image-storage-limit t))
    (terminal-set-kitty-graphics-max-bytes! t 4096)
    (terminal-set-kitty-graphics-max-bytes! t #f)
    (terminal-set-apc-max-bytes! t 1024)
    (terminal-set-apc-max-bytes! t #f)
    (check-raises assertion-violation? (terminal-set-kitty-image-storage-limit! t -1))
    (check-raises assertion-violation? (terminal-set-kitty-image-storage-limit! t (expt 2 64)))
    (check (not (terminal-kitty-image-file-medium? t)))
    (terminal-set-kitty-image-file-medium! t #t)
    (check (terminal-kitty-image-file-medium? t))
    (check (not (terminal-kitty-image-shared-memory-medium? t)))
    (check-equal? #f (terminal-kitty-image-temp-directory t))
    (terminal-set-kitty-image-temp-directory! t "/tmp")
    (check-equal? "/tmp" (terminal-kitty-image-temp-directory t))
    (terminal-set-kitty-image-temp-directory! t #f)
    (check-equal? #f (terminal-kitty-image-temp-directory t))))

(test "direct reads report size, cursor, screen and scrollback"
  (with-terminal (t 10 3)
    (terminal-write! t (bytes "ab\r\ncd"))
    (let ([c (terminal-cursor t)])
      (check-equal? 2 (cursor-x c))
      (check-equal? 1 (cursor-y c))
      (check (not (cursor-pending-wrap? c)))
      (check (cursor-visible? c))
      (check (not (cursor-at-prompt? c))))
    (terminal-write! t (bytes "\x1b;[?25l"))
    (check (not (cursor-visible? (terminal-cursor t))))
    (terminal-write! t (bytes "\x1b;[1;4;38;2;1;2;3m"))
    (let ([pen (terminal-cursor-pen t)])
      (check (style-bold? pen))
      (check-equal? 'single (style-underline pen))
      (check-equal? (make-rgb 1 2 3) (style-foreground pen))
      (check-equal? #f (style-background pen)))
    (check-equal? 'primary (terminal-active-screen t))
    (check-equal? 3 (terminal-total-rows t))
    (check-equal? 0 (terminal-scrollback-rows t))
    (terminal-write! t (bytes "\r\n1\r\n2\r\n3\r\n4"))
    (check-equal? 3 (terminal-scrollback-rows t))
    (check-equal? 6 (terminal-total-rows t))
    (let ([s (terminal-scrollbar t)])
      (check-equal? 6 (scrollbar-total s))
      (check-equal? 3 (scrollbar-offset s))
      (check-equal? 3 (scrollbar-length s)))
    (check (terminal-viewport-active? t))
    (terminal-scroll-to-top! t)
    (check (not (terminal-viewport-active? t)))
    (check-equal? 0 (scrollbar-offset (terminal-scrollbar t)))
    (terminal-scroll-by! t 1)
    (check-equal? 1 (scrollbar-offset (terminal-scrollbar t)))
    (terminal-scroll-to-row! t 2)
    (check-equal? 2 (scrollbar-offset (terminal-scrollbar t)))
    (terminal-scroll-to-top! t)
    (terminal-scroll-to-bottom! t)
    (check (terminal-viewport-active? t))
    (terminal-scroll-by-prompts! t -1)
    (check (not (terminal-vt-processing-error? t)))
    (check (not (terminal-mouse-tracking? t)))
    (terminal-write! t (bytes "\x1b;[?1000h"))
    (check (terminal-mouse-tracking? t))
    (check-equal? 'text (terminal-mouse-shape t))
    (terminal-write! t (bytes "\x1b;]22;pointer\x7;"))
    (check-equal? 'pointer (terminal-mouse-shape t))))

(test "titles and working directories"
  (with-terminal (t 10 2)
    (check-equal? "" (terminal-title t))
    (terminal-write! t (bytes "\x1b;]2;héllo\x7;"))
    (check-equal? "héllo" (terminal-title t))
    (terminal-set-title! t "set")
    (check-equal? "set" (terminal-title t))
    (terminal-set-title! t #f)
    (check-equal? "" (terminal-title t))
    (terminal-write! t (bytes "\x1b;]7;file://host/tmp\x1b;\\"))
    (check-equal? "file://host/tmp" (terminal-pwd t))
    (terminal-set-pwd! t "/home")
    (check-equal? "/home" (terminal-pwd t))
    (terminal-set-terminfo-name! t "xterm-ghostty")
    (check-raises ghostty-error? (terminal-set-terminfo-name! t (make-string 200 #\x)))))

(test "colors: defaults, overrides and palettes"
  (with-terminal (t 10 2)
    (let ([colors (terminal-colors t)])
      (check-equal? #f (color-theme-foreground colors))
      (check-equal? #f (color-theme-background colors))
      (check-equal? 256 (vector-length (color-theme-palette colors)))
      (check-equal? (color-default-palette) (color-theme-palette colors)))
    (terminal-set-default-foreground! t (make-rgb 200 200 200))
    (terminal-set-default-background! t (make-rgb 1 2 3))
    (terminal-set-default-cursor-color! t (make-rgb 9 9 9))
    (check-equal? (make-rgb 200 200 200) (color-theme-foreground (terminal-colors t)))
    (check-equal? (make-rgb 9 9 9) (color-theme-cursor (terminal-default-colors t)))
    (terminal-write! t (bytes "\x1b;]11;rgb:ff/00/00\x1b;\\\x1b;]4;1;rgb:00/ff/00\x1b;\\"))
    (check-equal? (make-rgb 255 0 0) (color-theme-background (terminal-colors t)))
    (check-equal? (make-rgb 1 2 3) (color-theme-background (terminal-default-colors t)))
    (check-equal? (make-rgb 0 255 0) (vector-ref (color-theme-palette (terminal-colors t)) 1))
    (let ([palette (make-vector 256 (make-rgb 7 7 7))])
      (terminal-set-default-palette! t palette)
      (check-equal? palette (color-theme-palette (terminal-default-colors t)))
      (check-equal? (make-rgb 0 255 0) (vector-ref (color-theme-palette (terminal-colors t)) 1))
      (check-equal? (make-rgb 7 7 7) (vector-ref (color-theme-palette (terminal-colors t)) 2)))
    (terminal-set-default-palette! t #f)
    (check-equal? (color-default-palette) (color-theme-palette (terminal-default-colors t)))
    (terminal-set-default-foreground! t #f)
    (check-equal? #f (color-theme-foreground (terminal-default-colors t)))
    (check-raises assertion-violation? (terminal-set-default-palette! t (make-vector 3 #f)))
    (check-raises assertion-violation? (make-rgb 256 0 0))))

(test "scrollback limits and other options round-trip"
  (with-terminal (t 10 3)
    (check-equal? #f (terminal-scrollback-max-lines t))
    (terminal-set-scrollback-max-lines! t 100)
    (check-equal? 100 (terminal-scrollback-max-lines t))
    (terminal-set-scrollback-max-lines! t #f)
    (check-equal? #f (terminal-scrollback-max-lines t))
    (terminal-set-scrollback-max-bytes! t 1000000)
    (check-equal? 1000000 (terminal-scrollback-max-bytes t))
    (terminal-set-clipboard-write-max-bytes! t 1000)
    (check-equal? 1000 (terminal-clipboard-write-max-bytes t))
    (terminal-set-clipboard-write-max-bytes! t #f)
    (check-equal? (* 64 1024 1024) (terminal-clipboard-write-max-bytes t))
    (terminal-set-default-cursor-style! t 'bar)
    (terminal-set-default-cursor-style! t #f)
    (check-raises assertion-violation? (terminal-set-default-cursor-style! t 'round))
    (terminal-set-default-cursor-blink! t #t)
    (terminal-set-glyph-protocol! t #f)
    (terminal-set-title-report! t #t)
    (terminal-set-resize-pull-scrollback! t #f)
    (terminal-set-checksum-report! t #t)
    (terminal-set-checksum-extension! t 31)
    (check-raises assertion-violation? (terminal-set-checksum-extension! t 32))
    (terminal-set-unknown-max-bytes! t 64)))

(test "modes: defaults, changes and resets"
  (with-terminal (t 10 3)
    (check-equal? 43 (length (terminal-modes)))
    (check-equal? '(srm wraparound cursor-visible alt-scroll numlock-keypad alt-esc-prefix)
      (filter (lambda (m) (terminal-mode-enabled? t m)) (terminal-modes)))
    (terminal-write! t (bytes "\x1b;[?2004h\x1b;[4h"))
    (check (terminal-mode-enabled? t 'bracketed-paste))
    (check (terminal-mode-enabled? t 'insert))
    (terminal-set-mode! t 'bracketed-paste #f)
    (check (not (terminal-mode-enabled? t 'bracketed-paste)))
    (terminal-set-mode-default! t 'decckm #t)
    (check (terminal-mode-enabled? t 'decckm))
    (terminal-reset! t)
    (check (terminal-mode-enabled? t 'decckm))
    (check (not (terminal-mode-enabled? t 'insert)))
    (check-raises assertion-violation? (terminal-mode-enabled? t 'no-such-mode))
    (check-raises assertion-violation? (terminal-set-mode! t 'insert 'yes))))

(test "formats: plain, VT and HTML"
  (with-terminal (t 20 3)
    (terminal-write! t (bytes "a\x1b;[1mb\x1b;[0m  \r\nlong line that wraps around"))
    (check-equal? "ab\nlong line that wraps\n around" (terminal->string t))
    (check-equal? "ab\nlong line that wraps around"
      (terminal-format t 'plain (format-options trim unwrap)))
    (check (string? (terminal-format t 'vt (format-options trim style))))
    (let ([html (terminal-format t 'html (format-options trim style))])
      (check (string? html))
      (check (> (string-length html) 20)))
    (check-raises assertion-violation? (terminal-format t 'rtf (format-options)))
    (check-raises assertion-violation? (terminal-format t 'plain '(trim)))))

(test "compression and memory usage"
  (with-terminal (t 80 24)
    (terminal-set-scrollback-max-lines! t #f)
    (do ([i 0 (+ i 1)]) ((= i 3000))
      (terminal-write! t (bytes (format "line ~a of scrollback text\r\n" i))))
    (let ([before (terminal-memory-usage t)])
      (check (> (memory-usage-primary-pages before) 1))
      (check-equal? 0 (memory-usage-alternate-pages before))
      (let ([activity (terminal-compression-activity t)])
        (check (integer? activity))
        (let loop ([n 0])
          (let ([result (terminal-compress! t)])
            (check (memq result '(pending complete unsupported)))
            (when (and (eq? result 'pending) (< n 10000)) (loop (+ n 1)))))
        (check (memq (terminal-compress-fully! t) '(complete unsupported)))
        (when (memory-usage-compression-supported? before)
          (check (> (memory-usage-primary-compressed-pages (terminal-memory-usage t)) 0)))))
    (check (string? (terminal->string t)))))

(test-exit)
