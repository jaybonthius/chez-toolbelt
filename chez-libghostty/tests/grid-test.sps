(import (chezscheme) (ghostty) (check))

(define (bytes s) (string->utf8 s))

(define-syntax with-terminal
  (syntax-rules ()
    [(_ (t columns rows) body ...)
     (let ([t (make-terminal columns rows)])
       (dynamic-wind void (lambda () body ...) (lambda () (terminal-close! t))))]))

(define (active x y) (make-grid-point 'active x y))
(define (screen x y) (make-grid-point 'screen x y))

(test "a cell carries its text, style, link and marks"
  (with-terminal (t 20 3)
    (terminal-write! t (bytes "\x1b;]133;A\x7;\x1b;]8;;https://example.test\x7;\x1b;[1;31m\x1b;[1\"qe\x301;\x1b;[0\"q\x1b;]8;;\x7;\x1b;[0m"))
    (let ([cell (terminal-cell t (active 0 0))] [row (terminal-row t (active 0 0))])
      (check-equal? 101 (grid-cell-codepoint cell))
      (check-equal? "e\x301;" (grid-cell-text cell))
      (check-equal? 'narrow (grid-cell-wide cell))
      (check-equal? 'codepoint-grapheme (grid-cell-content cell))
      (check (grid-cell-has-text? cell))
      (check (grid-cell-has-styling? cell))
      (check-equal? 1 (grid-cell-style-id cell))
      (check-equal? "https://example.test" (grid-cell-hyperlink cell))
      (check (grid-cell-protected? cell))
      (check-equal? 'prompt (grid-cell-semantic-content cell))
      (check-equal? #f (grid-cell-background cell))
      (check (style-bold? (grid-cell-style cell)))
      (check-equal? 1 (style-foreground (grid-cell-style cell)))
      (check (not (grid-row-wrap? row)))
      (check (not (grid-row-wrap-continuation? row)))
      (check (grid-row-grapheme? row))
      (check (grid-row-styled? row))
      (check (grid-row-hyperlink? row))
      (check-equal? 'prompt (grid-row-semantic-prompt row))
      (check (not (grid-row-kitty-virtual-placeholder? row)))
      (check (grid-row-dirty? row)))
    (let ([blank (terminal-cell t (active 5 0))])
      (check-equal? "" (grid-cell-text blank))
      (check (not (grid-cell-has-text? blank)))
      (check-equal? #f (grid-cell-hyperlink blank)))))

(test "wide characters, color-only cells and soft wraps"
  (with-terminal (t 8 3)
    (terminal-write! t (bytes "ab界cd"))
    (let ([wide (terminal-cell t (active 2 0))] [tail (terminal-cell t (active 3 0))])
      (check-equal? "界" (grid-cell-text wide))
      (check-equal? 'wide (grid-cell-wide wide))
      (check-equal? 'spacer-tail (grid-cell-wide tail))
      (check (not (grid-cell-has-text? tail)))))
  (with-terminal (t 5 3)
    (terminal-write! t (bytes "\x1b;[41m\x1b;[2K"))
    (let ([cell (terminal-cell t (active 0 0))])
      (check-equal? 'bg-color-palette (grid-cell-content cell))
      (check-equal? 1 (grid-cell-background cell))
      (check-equal? "" (grid-cell-text cell)))
    (terminal-write! t (bytes "\x1b;[48;2;1;2;3m\x1b;[2K"))
    (check-equal? (make-rgb 1 2 3) (grid-cell-background (terminal-cell t (active 0 0))))
    (terminal-reset! t)
    (terminal-write! t (bytes "abcdef"))
    (check (grid-row-wrap? (terminal-row t (active 0 0))))
    (check (grid-row-wrap-continuation? (terminal-row t (active 0 1))))))

(test "points convert between spaces"
  (with-terminal (t 10 3)
    (terminal-write! t (bytes "1\r\n2\r\n3\r\n4\r\n5"))
    (check-equal? (screen 0 4) (terminal-point-convert t (active 0 2) 'screen))
    (check-equal? (make-grid-point 'history 0 1) (terminal-point-convert t (screen 0 1) 'history))
    (check-equal? #f (terminal-point-convert t (screen 0 0) 'active))
    (check-raises ghostty-error? (terminal-cell t (active 10 0)))
    (check-raises assertion-violation? (make-grid-point 'active -1 0))
    (check-raises assertion-violation? (make-grid-point 'sideways 0 0))
    (check-equal? "1" (grid-cell-text (terminal-cell t (screen 0 0))))))

(test "tracked points follow their cell"
  (with-terminal (t 8 3)
    (for-each
      (lambda (space)
        (let ([tp (make-tracked-point t (make-grid-point space 0 0))])
          (for-each
            (lambda (out) (check-equal? (make-grid-point out 0 0) (tracked-point-ref tp out)))
            '(active viewport screen history))
          (tracked-point-close! tp)))
      '(active viewport screen history))
    (terminal-write! t (bytes "primary"))
    (let ([tp (make-tracked-point t (active 0 0))])
      (check-raises ghostty-error? (make-tracked-point t (active 8 0)))
      (terminal-write! t (bytes "\r\n1\r\n2\r\n3"))
      (check-equal? (screen 0 0) (tracked-point-ref tp 'screen))
      (check-equal? #f (tracked-point-ref tp 'active))
      (check-equal? "p" (grid-cell-text (tracked-point-cell tp)))
      (check (not (grid-row-wrap? (tracked-point-row tp))))
      (terminal-write! t (bytes "\x1b;[?1049h\x1b;[Halternate"))
      (check-equal? "p" (grid-cell-text (tracked-point-cell tp)))
      (tracked-point-move! tp (active 0 0))
      (terminal-write! t (bytes "\x1b;[?1049l"))
      (check-equal? "a" (grid-cell-text (tracked-point-cell tp)))
      (tracked-point-move! tp (active 0 0))
      (terminal-reset! t)
      (check (not (tracked-point-valid? tp)))
      (check-equal? #f (tracked-point-ref tp 'screen))
      (check-equal? #f (tracked-point-cell tp))
      (tracked-point-move! tp (active 0 0))
      (check (tracked-point-valid? tp))
      (terminal-close! t)
      (check (not (tracked-point-valid? tp)))
      (check-equal? #f (tracked-point-cell tp))
      (check-raises assertion-violation? (tracked-point-move! tp (active 0 0)))
      (tracked-point-close! tp)
      (tracked-point-close! tp)
      (check (tracked-point-closed? tp))
      (check-raises assertion-violation? (tracked-point-valid? tp)))))

(test "selections: ranges, rectangles, order and containment"
  (with-terminal (t 12 3)
    (terminal-write! t (bytes "alpha beta\r\n0123456789"))
    (terminal-select! t (active 6 0) (active 9 0))
    (let ([s (terminal-selection t)])
      (check-equal? "beta" (terminal-selection->string t))
      (check-equal? (screen 6 0) (selection-start s))
      (check-equal? (screen 9 0) (selection-end s))
      (check (not (selection-rectangle? s))))
    (check-equal? 'forward (terminal-selection-order t))
    (check (terminal-selection-contains? t (active 7 0)))
    (check (not (terminal-selection-contains? t (active 2 0))))
    (terminal-select! t (active 9 0) (active 6 0))
    (check-equal? 'reverse (terminal-selection-order t))
    (terminal-select-rectangle! t (active 9 0) (active 6 1))
    (check-equal? 'mirrored-forward (terminal-selection-order t))
    (check-equal? "beta\n6789" (terminal-selection->string t))
    (check (selection-rectangle? (terminal-selection t)))
    (terminal-select-rectangle! t (active 6 1) (active 9 0))
    (check-equal? 'mirrored-reverse (terminal-selection-order t))
    (check (string? (terminal-format-selection t 'html (format-options))))
    (terminal-clear-selection! t)
    (terminal-clear-selection! t)
    (check-equal? #f (terminal-selection t))
    (check-equal? #f (terminal-selection->string t))
    (check-equal? #f (terminal-selection-order t))
    (check (not (terminal-selection-contains? t (active 0 0))))))

(test "word, line, output and whole-screen selections"
  (with-terminal (t 24 5)
    (terminal-write! t (bytes "foo:bar  alpha beta  \r\n"))
    (check (selection? (terminal-select-word! t (active 1 0))))
    (check-equal? "foo" (terminal-selection->string t))
    (check-equal? #f (terminal-select-output! t (active 1 0)))
    (check-equal? "foo" (terminal-selection->string t))
    (check (terminal-select-word! t (active 1 0) ""))
    (check-equal? "foo:bar  alpha beta" (terminal-selection->string t))
    (check (terminal-select-word! t (active 1 0) ":"))
    (check-equal? "foo" (terminal-selection->string t))
    (check (terminal-select-word-between! t (active 10 0) (active 17 0)))
    (check-equal? "alpha" (terminal-selection->string t))
    (check (terminal-select-line! t (active 12 0)))
    (check-equal? "foo:bar  alpha beta" (terminal-selection->string t))
    (check (terminal-select-line! t (active 12 0) ""))
    (check-equal? "foo:bar  alpha beta  " (terminal-format-selection t 'plain (format-options unwrap)))
    (terminal-write! t (bytes "\x1b;]133;A\x7;$ \x1b;]133;B\x7;command\r\n"))
    (check (terminal-select-line! t (active 4 1)))
    (check-equal? "$ command" (terminal-selection->string t))
    (check (terminal-select-semantic-line! t (active 4 1)))
    (check-equal? "command" (terminal-selection->string t))
    (terminal-write! t (bytes "\x1b;]133;A\x7;$ echo hi\r\n\x1b;]133;C\x7;hi\r\n\x1b;]133;D;0\x7;"))
    (check (terminal-select-output! t (active 0 3)))
    (check-equal? "hi" (terminal-selection->string t))
    (check-equal? (screen 0 0) (selection-start (terminal-select-all! t)))))

(test "every selection adjustment moves the end"
  (for-each
    (lambda (entry)
      (with-terminal (t 10 5)
        (terminal-write! t (bytes "0000000000111111111122222222223333333333444444444455555555556666666666777777777788888888889999999999"))
        (let ([y (cadr entry)])
          (terminal-select! t (screen 4 y) (screen 5 y))
          (let ([s (terminal-selection-adjust! t (car entry))])
            (check-equal? (screen 4 y) (selection-start s))
            (check-equal? (screen (caddr entry) (cadddr entry)) (selection-end s))
            (check-equal? s (terminal-selection t))))))
    '((left 3 4 3) (right 3 6 3) (up 3 5 2) (down 3 5 4) (home 3 0 0)
      (end 3 9 9) (page-up 6 5 1) (page-down 3 5 8) (beginning-of-line 3 0 3) (end-of-line 3 9 3)))
  (with-terminal (t 5 3)
    (check-equal? #f (terminal-selection-adjust! t 'left))
    (check-raises assertion-violation? (terminal-selection-adjust! t 'sideways))))

(test "selections across soft wraps, screen switches and trimmed history"
  (with-terminal (t 5 3)
    (terminal-write! t (bytes "abcdef"))
    (terminal-select! t (active 0 0) (active 0 1))
    (check-equal? "abcdef" (terminal-selection->string t))
    (check-equal? "abcde\nf" (terminal-format-selection t 'plain (format-options trim)))
    (terminal-write! t (bytes "\x1b;[?1049h"))
    (check-equal? #f (terminal-selection t))
    (terminal-write! t (bytes "alt"))
    (check (terminal-select-all! t))
    (terminal-write! t (bytes "\x1b;[?1049l"))
    (check-equal? #f (terminal-selection t))
    (terminal-reset! t)
    (check-equal? #f (terminal-selection t)))
  (with-terminal (t 20 3)
    (terminal-write! t (bytes "selected"))
    (let ([tp (make-tracked-point t (active 0 0))])
      (check (terminal-select-all! t))
      (do ([n 0 (+ n 1)]) ((= n 100)) (terminal-write! t (bytes "line\r\n")))
      (check-equal? (make-grid-point 'history 0 0) (tracked-point-ref tp 'history))
      (check-equal? "selected" (terminal-selection->string t))
      (terminal-set-scrollback-max-lines! t 10)
      (do ([n 0 (+ n 1)]) ((= n 20000)) (terminal-write! t (bytes "line\r\n")))
      ;; libghostty-vt keeps a selection whose rows were trimmed, moved
      ;; to the top of the screen; its text is gone.
      (check (not (tracked-point-valid? tp)))
      (check (not (equal? "selected" (terminal-selection->string t))))
      (tracked-point-move! tp (active 0 0))
      (check (tracked-point-valid? tp))
      (tracked-point-close! tp))))

(test "search finds matches in scrollback and follows the terminal"
  (with-terminal (t 20 3)
    (terminal-write! t (bytes "foo one\r\nbar\r\nFOO two\r\nbaz\r\nfoo three"))
    (let ([s (make-search t)])
      (check-equal? 'complete (search-status s))
      (search-set-needle! s "foo")
      (search-run! s)
      (check-equal? 'complete (search-status s))
      (check-equal? 3 (search-total s))
      (let ([matches (search-matches s)])
        (check-equal? '(4 2 0) (map (lambda (m) (grid-point-y (selection-start m))) matches))
        (check-equal? '(2 2 2) (map (lambda (m) (grid-point-x (selection-end m))) matches)))
      (check (<= 1 (length (search-viewport-matches s)) 3))
      (check-equal? #f (search-selected-index s))
      (check-equal? #f (search-selected-match s))
      (check-equal? 4 (grid-point-y (selection-start (search-select-next! s))))
      (check-equal? 0 (search-selected-index s))
      (check-equal? 2 (grid-point-y (selection-start (search-select-next! s))))
      (check-equal? 2 (grid-point-y (selection-start (search-selected-match s))))
      (check-equal? 4 (grid-point-y (selection-start (search-select-previous! s))))
      (search-set-scroll! s 'none)
      (terminal-write! t (bytes "\r\nfoo four"))
      (check (symbol? (search-feed! s)))
      (let loop () (unless (eq? (search-tick! s) 'complete) (search-feed! s) (loop)))
      (check-equal? 4 (search-total s))
      (search-set-needle! s #f)
      (check-equal? 0 (search-total s))
      (check-equal? #f (search-select-next! s))
      (search-close! s)
      (search-close! s)
      (check (search-closed? s))
      (check-raises assertion-violation? (search-total s))))
  (let* ([t (make-terminal 20 3)] [s (make-search t)])
    (search-set-needle! s "x")
    (terminal-close! t)
    (check-raises assertion-violation? (search-feed! s))
    (check-equal? 0 (search-total s))
    (search-close! s)))

(test "selection gestures drag, repeat clicks and install selections"
  (with-terminal (t 20 4)
    (terminal-write! t (bytes "hello world\r\nsecond line"))
    (let ([g (make-selection-gesture t)] [geometry (make-gesture-geometry 20 10 0 40)])
      (check-equal? #f (selection-gesture-press! g (active 0 0) 2 8 #f))
      (let ([s (selection-gesture-drag! g (active 4 0) 46 8 geometry)])
        (check-equal? 0 (grid-point-x (selection-start s)))
        (check-equal? 4 (grid-point-x (selection-end s)))
        (check (not (selection-rectangle? s))))
      (check-equal? "hello" (terminal-selection->string t))
      (check (selection-rectangle? (selection-gesture-drag-rectangle! g (active 4 1) 46 18 geometry)))
      (selection-gesture-drag! g (active 4 0) 46 8 geometry)
      (selection-gesture-release! g (active 4 0))
      (check (gesture-state-dragged? (selection-gesture-state g)))
      (selection-gesture-reset! g)
      (check-equal? 0 (gesture-state-click-count (selection-gesture-state g)))
      (selection-gesture-set-repeat-limits! g 10 500000000)
      (selection-gesture-press! g (active 7 0) 72 8 1000)
      (selection-gesture-release! g (active 7 0))
      (selection-gesture-press! g (active 7 0) 72 8 2000)
      (check-equal? 2 (gesture-state-click-count (selection-gesture-state g)))
      (check-equal? 'word (gesture-state-behavior (selection-gesture-state g)))
      (check-equal? "world" (terminal-selection->string t))
      (selection-gesture-reset! g)
      (selection-gesture-press! g (active 2 1) 22 18 #f)
      (check (grid-point? (gesture-state-anchor (selection-gesture-state g))))
      (check (selection? (selection-gesture-deep-press! g)))
      (check-equal? "second" (terminal-selection->string t))
      (selection-gesture-set-behaviors! g 'line 'word 'cell)
      (selection-gesture-reset! g)
      (selection-gesture-press! g (active 2 1) 22 18 #f)
      (check-equal? "second line" (terminal-selection->string t))
      (check-raises assertion-violation? (selection-gesture-set-behaviors! g 'line 'word 'paragraph))
      (selection-gesture-close! g)
      (check (selection-gesture-closed? g))
      (check-raises assertion-violation? (selection-gesture-state g)))))

(test "autoscroll ticks extend a drag past the screen's edge"
  (with-terminal (t 20 4)
    (terminal-write! t (bytes "a\r\nb\r\nc\r\nd\r\ne\r\nf\r\ng\r\nhello world\r\nsecond line"))
    (let ([g (make-selection-gesture t)] [geometry (make-gesture-geometry 20 10 0 40)])
      (check-equal? #f (selection-gesture-autoscroll-tick! g 4 0 46 -5 geometry))
      (selection-gesture-press! g (active 0 2) 2 28 #f)
      (selection-gesture-drag! g (active 4 0) 46 -5 geometry)
      (check-equal? 'up (gesture-state-autoscroll (selection-gesture-state g)))
      (check (selection-rectangle? (selection-gesture-autoscroll-tick-rectangle! g 4 0 46 -5 geometry)))
      (check (not (selection-rectangle? (selection-gesture-autoscroll-tick! g 4 0 46 -5 geometry))))
      (selection-gesture-close! g))))

(test-exit)
