(import (chezscheme) (parakeet) (check) (fixtures) (json))

(define bundle "parakeet-bundle-small.gguf")
(define asr-model "tdt_ctc-110m-q8_0.gguf")
(define eou-model "realtime_eou_120m-v1-q8_0.gguf")
(define speaker-model "wespeaker-resnet34-voxceleb.gguf")
(define two-voices (read-wav two-speakers-wav))
(define thunder (read-wav thunder-wav))

(define (pieces samples size)
  (let ([n (float-count samples)])
    (let loop ([at 0] [pieces '()])
      (if (>= at n)
          (reverse pieces)
          (let ([end (min n (+ at size))])
            (loop end (cons (sub-samples samples at end) pieces)))))))

(define (feed-all feed finish s samples)
  (let ([fed (fold-left (lambda (fed piece) (append fed (feed s piece))) '()
               (pieces samples 16000))])
    (append fed (finish s))))

(define (with-models specs proc)
  (let ([models (map (lambda (spec) (load-model (model-path (car spec)) (cdr spec))) specs)])
    (let ([result (apply proc models)])
      (for-each close-model models)
      result)))

(test "offline diarization matches parakeet.cpp"
  (with-model bundle "diar"
    (lambda (d)
      (check-equal? 'diarization (model-kind d))
      (let ([document (diarize-pcm-json d two-voices)])
        (check-equal? (reference-text "diarize.txt") document)
        (check-equal? document (diarize-file-json d two-speakers-wav))
        (let ([speakers (map (lambda (s) (json-ref s "speaker"))
                          (json-ref (string->json document) "segments"))])
          (check (memv 0 speakers))
          (check (memv 1 speakers))))
      (check-equal? '() (json-ref (string->json (diarize-pcm-json d (bytevector))) "segments"))
      (check-raises parakeet-error? (transcribe-pcm d speech-samples)))))

(test "diarization streams at every latency"
  (with-model bundle "diar"
    (lambda (d)
      (for-each
        (lambda (latency)
          (let ([s (open-diarization-stream d latency)])
            (check-equal? 0.0 (diarization-stream-time s))
            (check-equal? '() (diarization-stream-active s))
            (check (> (diarization-stream-chunk-samples s) 0))
            (let ([segments (feed-all diarization-stream-feed diarization-stream-finish s two-voices)])
              (check (pair? segments))
              (check (for-all (lambda (g) (< (diarization-segment-start g) (diarization-segment-end g)))
                       segments))
              (check (memv 1 (map diarization-segment-speaker segments))))
            (check (> (diarization-stream-time s) 20.0))
            (check-equal? '() (diarization-stream-active s))
            (check-raises parakeet-error? (diarization-stream-feed s (silence 160)))
            (close-diarization-stream s)
            (close-diarization-stream s)
            (check-raises assertion-violation? (diarization-stream-time s))))
        (list (diarization-latency model) (diarization-latency low)
              (diarization-latency very-low) (diarization-latency ultra-low))))))

(test "attributed speech says who said what, offline and streamed"
  (with-models (list (cons asr-model #f) (cons bundle "diar"))
    (lambda (a d)
      (let ([utterances (transcribe-and-diarize a d two-voices)]
            [json (string->json (transcribe-and-diarize-json a d two-voices))])
        (check (pair? utterances))
        (check-equal? (map (lambda (u) (json-ref u "text")) (json-ref json "utterances"))
          (map attributed-utterance-text utterances))
        (check-equal? (map (lambda (u) (json-ref u "speaker")) (json-ref json "utterances"))
          (map (lambda (u) (or (attributed-utterance-speaker u) -1)) utterances))
        (check (for-all (lambda (u) (<= 0 (attributed-utterance-confidence u) 1)) utterances)))
      (for-each
        (lambda (asr)
          (let ([s (open-attribution-stream asr d (diarization-latency low))])
            (let ([utterances (feed-all attribution-stream-feed attribution-stream-finish s
                                two-voices)])
              (check (pair? utterances))
              (check (for-all (lambda (u) (string? (attributed-utterance-text u))) utterances)))
            (check-raises parakeet-error? (attribution-stream-feed s (silence 160)))
            (close-attribution-stream s)))
        (list a))
      (with-model eou-model
        (lambda (eou)
          (let ([s (open-attribution-stream eou d)])
            (check (pair? (feed-all attribution-stream-feed attribution-stream-finish s two-voices)))
            (close-attribution-stream s))))
      (check-raises parakeet-error? (transcribe-and-diarize d a two-voices)))))

(test "sound events have labels, peaks and scores"
  (with-model "ced-tiny-q8_0.gguf"
    (lambda (t)
      (check-equal? 'sound (model-kind t))
      (let ([labels (model-sound-labels t)])
        (check-equal? 527 (vector-length labels))
        (check-equal? "Speech" (vector-ref labels 0))
        (let ([s (open-sound-stream t (sound-options [top-k 3]))])
          (let ([segments (feed-all sound-stream-feed sound-stream-finish s thunder)])
            (check (pair? segments))
            (for-each
              (lambda (g)
                (check-equal? (vector-ref labels (sound-segment-class g)) (sound-segment-label g))
                (check (<= (sound-segment-start g) (sound-segment-end g)))
                (check (<= 0 (sound-segment-peak g) 1)))
              segments))
          (let ([scores (string->json (sound-stream-drain-scores-json s))])
            (check (pair? scores))
            (check-equal? 3 (length (json-ref (car scores) "tags"))))
          (check-equal? "[]" (sound-stream-drain-scores-json s))
          (check-equal? '() (sound-stream-active s))
          (check-raises parakeet-error? (sound-stream-feed s (silence 160)))
          (close-sound-stream s)))
      (check-raises parakeet-error? (open-sound-stream t (sound-options [top-k 528])))
      (check-raises parakeet-error? (open-sound-stream t (sound-options [window 0.5] [hop 1.0])))
      (let ([s (open-sound-stream t)])
        (sound-stream-feed s (sub-samples thunder 0 32000))
        (check (list? (sound-stream-active s)))
        (close-sound-stream s)))))

(test "a scene combines speech, diarization and sound events"
  (with-models (list (cons asr-model #f) (cons bundle "diar") (cons "ced-tiny-q8_0.gguf" #f))
    (lambda (a d t)
      (let ([s (open-scene-stream a d t (scene-options [diarization-latency 'low]
                                          [sound (sound-options [top-k 2])]))])
        (let* ([fed (fold-left (lambda (fed piece) (append fed (list (scene-stream-feed-json s piece))))
                      '() (pieces two-voices 16000))]
               [documents (append fed (list (scene-stream-finish-json s)))])
          (let ([utterances (apply append
                              (map (lambda (d) (json-ref (string->json d) "utterances")) documents))])
            (check (pair? utterances))))
        (check (pair? (string->json (scene-stream-drain-scores-json s))))
        (check-equal? "[]" (scene-stream-drain-scores-json s))
        (guard (c [(parakeet-error? c) (check (positive? (string-length (condition-message c))))])
          (scene-stream-feed-json s (silence 160))
          (check #f))
        (close-scene-stream s))
      (let ([s (open-scene-stream #f #f t)])
        (check (string? (scene-stream-finish-json s thunder)))
        (close-scene-stream s))
      (check-raises assertion-violation? (open-scene-stream #f #f #f))
      (check-raises parakeet-error? (open-scene-stream d #f #f)))))

(test "speakers are named from a registry"
  (with-models (list (cons asr-model #f) (cons bundle "diar") (cons speaker-model #f))
    (lambda (a d sp)
      (let ([r (make-speaker-registry)])
        (enroll-speaker! r sp "Ada" (sub-samples two-voices 9600 73600))
        (enroll-speaker! r sp "Ben" (sub-samples two-voices 110400 174400))
        (let ([names (json-ref (string->json (diarize-named-pcm-json d sp r two-voices)) "names")])
          (check (pair? names))
          (check (for-all (lambda (entry) (member (json-ref (cdr entry) "name") '("Ada" "Ben")))
                   names)))
        (let ([strict (json-ref (string->json
                                  (diarize-named-pcm-json d sp r two-voices 16000
                                    (speaker-options [accept-threshold 0.99] [margin 0.5])))
                        "names")])
          (check (for-all (lambda (entry) (equal? "" (json-ref (cdr entry) "name"))) strict)))
        (let ([profiles (json-ref (string->json (diarize-profiles-pcm-json d sp #f two-voices))
                          "speaker_profiles")])
          (check-equal? 1 (json-ref profiles "version"))
          (check-equal? (model-speaker-identity sp) (json-ref profiles "encoder" "identity")))
        (check (pair? (json-ref (string->json (diarize-profiles-pcm-json d sp r two-voices))
                        "speaker_profiles" "speakers")))
        (let ([words (json-ref (string->json
                                 (transcribe-and-diarize-named-json a d sp r two-voices))
                       "words")])
          (check (pair? words))
          (check (member (json-ref (car words) "name") '("Ada" "Ben" ""))))
        (let ([s (open-scene-stream #f d #f sp r (scene-options [diarization-latency 'low]))]
              [voice (sub-samples two-voices 9600 73600)])
          (check-raises assertion-violation? (enroll-speaker! r sp "Cy" voice))
          (check-raises assertion-violation?
            (speaker-registry-add! r "Cy" (embed-speaker sp voice)))
          (check-raises assertion-violation? (speaker-registry-strict-set! r #t))
          (check-equal? 2 (speaker-registry-size r))
          (check (string? (scene-stream-finish-json s two-voices)))
          (close-scene-stream s)
          (enroll-speaker! r sp "Cy" voice)
          (check-equal? 3 (speaker-registry-size r)))
        (check-raises parakeet-error? (diarize-named-pcm-json d sp r (bytevector)))
        (check-raises assertion-violation? (open-scene-stream #f d #f sp #f))
        (close-speaker-registry r)))))

(test-exit)
