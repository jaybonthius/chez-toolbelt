#!/bin/sh
# parakeet.cpp's configure step patches ggml in the tree it builds, so it
# builds from a copy of the pinned commits and the checkout stays as pinned.
set -eu
checkout=$1
destination=$2
if git -C "$checkout" submodule status --recursive | grep -q '^[-+U]'; then
  echo "$checkout: a submodule is missing or not at its pinned commit;" \
    "run git submodule update --init --recursive" >&2
  exit 1
fi
state=$(git -C "$checkout" rev-parse HEAD; git -C "$checkout" submodule status --recursive)
if [ -f "$destination/.state" ] && [ "$(cat "$destination/.state")" = "$state" ]; then
  exit 0
fi
rm -rf "$destination"
mkdir -p "$destination"
git -C "$checkout" archive HEAD | tar -x -C "$destination"
DESTINATION=$(cd "$destination" && pwd) git -C "$checkout" submodule foreach --quiet --recursive \
  'git archive HEAD | tar -x -C "$DESTINATION/$displaypath"'
# The configure step applies its ggml patches with git apply, and skips them
# outside a git repository.
git init -q "$destination/third_party/ggml"
printf '%s\n' "$state" > "$destination/.state"
