#!/bin/sh
set -eu
directory=$1
check_only=${2:-}
parakeet=https://huggingface.co/mudler/parakeet-cpp-gguf/resolve/07a08a3a405d20c5434b9a1442f6e6cf571f57ad
ced=https://huggingface.co/mudler/ced-gguf/resolve/b5e9a4aad6438763c8da16079d77563fbed35c65
voice=https://huggingface.co/mudler/voice-detect-gguf/resolve/a45a8e5ef6b267eb903bc5b95efa1c5257fa005b

models="
$parakeet/tdt_ctc-110m-q8_0.gguf 614feee3a990cf0e672b0314f4da0c80ae8da9094507f5ccb7c42e43b5fc5a12
$parakeet/realtime_eou_120m-v1-q8_0.gguf 62616b914d6f5a683a5dea672df055b57de5c49dddf871b8b44b9c814dc3d896
$parakeet/nemotron-3.5-asr-streaming-0.6b-q8_0.gguf ba2f13eccd4a5245be728f77e6149bd6a4fdcdd133ff2e08ac6005bcef7a99f1
$parakeet/nemotron-labs-unified-asr-0.6b-q4_k.gguf e5e0f9c2f0a330c4d91781b4cb7e5251fe3a7dc171874b9da69b5d2408575313
$parakeet/redux-packed.gguf 574614b9a4d9f72ab202877a7ad6a1f4bf819dd1d27b9d42dfe8cd429fcebdd5
$parakeet/parakeet-bundle-small.gguf 5f2c6697eb08d4d67e858692d4223a9d911aacc51ae16cf2aee9e760f8a2269a
$ced/ced-tiny-q8_0.gguf 48bee4e2fc3cc85d7806e03471db24e77fda6c2a2e81ffe9ef67caebaf2bd674
$voice/wespeaker-resnet34-voxceleb.gguf 72040372494eafec299836bc1977cfc13c603cb486674ed59b0f4c03758d29da
"

mkdir -p "$directory"
echo "$models" | while read -r url hash; do
  [ -n "$url" ] || continue
  file=$directory/$(basename "$url")
  if [ -f "$file" ] && echo "$hash  $file" | sha256sum -c --status -; then
    continue
  fi
  if [ "$check_only" = --check ]; then
    echo "missing or changed: $file (run make models)" >&2
    exit 1
  fi
  curl -fL --retry 3 -o "$file.part" "$url"
  echo "$hash  $file.part" | sha256sum -c --quiet -
  mv "$file.part" "$file"
done
